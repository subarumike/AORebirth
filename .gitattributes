# Normalize maintained text to LF unless a narrower rule below overrides it.
* text=auto eol=lf

*.cs text eol=lf diff=csharp
*.csproj text eol=lf merge=union
*.sln text eol=lf merge=union
*.vbproj text eol=lf merge=union
*.fsproj text eol=lf merge=union
*.dbproj text eol=lf merge=union
*.props text eol=lf
*.targets text eol=lf
*.config text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.hex text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows launchers must remain directly executable by cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# Custom for Visual Studio

# Binary and archive formats are never line-ending normalized.
*.bin -text
*.dll -text
*.dmp -text
*.exe -text
*.gif -text
*.ico -text
*.jpeg -text
*.jpg -text
*.nupkg -text
*.odt -text
*.ods -text
*.pcap -text
*.pcapng -text
*.pdf -text
*.pdb -text
*.png -text
*.zip -text

# Capture-backed PF127 geometry is byte-hash validated and must remain LF-only.
AORebirth/Server/ZoneEngine/Content/Captured/Subway/pf127-geometry.json text eol=lf

# The deterministic full-corpus combat inventory exceeds GitHub's normal blob limit.
docs/generated/capture_backed_npc_combat_inventory.json filter=lfs diff=lfs merge=lfs -text

# Unified patches require the standard prefix space on blank context lines.
tools-temp/AOSharpLiveInjector/patches/*.patch whitespace=-blank-at-eol

# Standard to msysgit
*.doc  diff=astextplain
*.DOC  diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF  diff=astextplain
*.rtf  diff=astextplain
*.RTF  diff=astextplain

# Preserve compression-parity fixtures byte-for-byte.
LinuxBuild/Tools/CompatibilitySmokeTests/Fixtures/*.dat binary
