{
  "git.enabled": true,
  "git.autofetch": true,
  "git.confirmSync": true,
  "git.openRepositoryInParentFolders": "always",
  "github.gitProtocol": "https",
  "git.defaultBranchName": "master",
  "git.branchProtection": ["master"],
  "git.detectSubmodules": true,
  "files.exclude": {
    "password decoder": true
  },
  "json.schemas": [
    { "fileMatch": ["**/GameData/MonsterCombatRules.json"], "url": "./AORebirth/Schemas/MonsterCombatRules.schema.json" },
    { "fileMatch": ["**/GameData/NpcPetSummons.json"], "url": "./AORebirth/Schemas/NpcPetSummons.schema.json" },
    { "fileMatch": ["**/GameData/NpcSummonFallbacks.json"], "url": "./AORebirth/Schemas/NpcSummonFallbacks.schema.json" },
    { "fileMatch": ["**/GameData/NpcTemplates.json"], "url": "./AORebirth/Schemas/NpcTemplates.schema.json" },
    { "fileMatch": ["**/Config/Gameplay.json"], "url": "./AORebirth/Schemas/Gameplay.schema.json" },
    { "fileMatch": ["**/GameData/QuestRewards.json"], "url": "./AORebirth/Schemas/QuestRewards.schema.json" },
    { "fileMatch": ["**/GameData/Quests.json"], "url": "./AORebirth/Schemas/Quests.schema.json" }
  ]
}
