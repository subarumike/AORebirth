# Copy to .env and adapt. .env is never committed.
# A value containing '#' or spaces must be quoted. The process environment overrides this file.

# Read-only access to the AORebirth database (MariaDB / MySQL).
PORK_DB_HOST=127.0.0.1
PORK_DB_PORT=3306
PORK_DB_NAME=aorebirth
PORK_DB_USER=pork_reader
PORK_DB_PASSWORD=

# Folder served over HTTP (nginx). Relative paths start from this folder.
PORK_EXPORT_PATH=export

# Watermarks and quarantine, kept outside the served folder.
PORK_STATE_PATH=state

# GameData selected for the engines (same variable). Read only.
AO_REBIRTH_GAMEDATA_PATH=

# Dimension number in the published paths (/d/<n>/).
PORK_DIMENSION=11

# Seconds between two checks of the meta tables, and online heartbeat period.
PORK_TICK_SECONDS=30
# Rows committed late are still read: the watermark is lowered by this many seconds.
PORK_OVERLAP_SECONDS=60

# Hours between two sweeps.
PORK_SWEEP_HOURS=24
# Days an orphan file stays in quarantine; 0 deletes it at once.
PORK_QUARANTINE_DAYS=7
# A sweep that would remove more than this share of a family is aborted.
PORK_SWEEP_ABORT_PERCENT=5

# 1 logs the cost of every pass (heartbeat measurement).
PORK_DEBUG_HEARTBEAT=0
