<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsolatedMissionSources)' == 'true'">
    <DefineConstants>$(DefineConstants);MISSION_DAO_ISOLATED_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsolatedMissionSources)' != 'true'">
    <ProjectReference Include="../../LinuxBuild/Projects/AORebirth.Database.Linux.csproj" />
    <ProjectReference Include="../../LinuxBuild/Projects/AORebirth.Interfaces.Linux.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsolatedMissionSources)' == 'true'">
    <!-- Compile the actual persistence sources, never a second DAO implementation. -->
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Interfaces/Persistence/Accounts/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Interfaces/Persistence/Characters/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Domain/Characters/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Domain/Accounts/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Interfaces/Persistence/Missions/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Domain/Missions/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/DatabaseDaoFactory.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Dao/NewCharacterStartAreaSelectionDao.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Enums/StatIds.cs" />
    <PackageReference Include="Dapper" Version="2.1.79" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
  </ItemGroup>
</Project>
