<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AORebirth.NpcEditor.AOSharp</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\AORebirth.NpcEditor.Official\OfficialSnapshot.cs" Link="OfficialSnapshot.cs" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="AOSharp.Core">
      <HintPath>$(AOSharpPath)\AOSharp.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AOSharp.Common">
      <HintPath>$(AOSharpPath)\AOSharp.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckAOSharpPath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AOSharpPath)\AOSharp.Core.dll') Or !Exists('$(AOSharpPath)\AOSharp.Common.dll')"
           Text="Supply -p:AOSharpPath=path to the installed AOSharp runtime directory." />
  </Target>
</Project>
