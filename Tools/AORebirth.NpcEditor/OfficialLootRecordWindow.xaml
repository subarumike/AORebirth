<Window x:Class="AORebirth.NpcEditor.OfficialLootRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record opened-corpse observation" Width="650" Height="510" MinWidth="500" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Style="{StaticResource EditorWindowStyle}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add local observation" Click="Record_Click" />
                <Button Content="Cancel" IsCancel="True" Margin="0" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="SourceNpc" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <TextBlock Text="Record only what you saw after opening the corpse. The NPC association is manual."
                           Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <WrapPanel>
                    <StackPanel Width="205" Margin="0,0,8,6">
                        <TextBlock Text="Observation classification" />
                        <ComboBox x:Name="ObservationStatus" SelectionChanged="ObservationStatus_Changed" AutomationProperties.Name="Observation classification">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,8,6">
                        <TextBlock Text="Corpse identity, if visible" />
                        <TextBox x:Name="CorpseIdentity" MaxLength="160" AutomationProperties.Name="Observed corpse identity" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,0,6">
                        <TextBlock Text="Credits" />
                        <TextBox x:Name="Credits" MaxLength="10" AutomationProperties.Name="Observed credits" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Item name, if visible" />
                <TextBox x:Name="ItemName" MaxLength="256" AutomationProperties.Name="Observed item name" />
                <WrapPanel Margin="0,8,0,0">
                    <StackPanel Width="105" Margin="0,0,8,6">
                        <TextBlock Text="Low AOID" />
                        <TextBox x:Name="LowId" MaxLength="10" AutomationProperties.Name="Observed low item template ID" />
                    </StackPanel>
                    <StackPanel Width="105" Margin="0,0,8,6">
                        <TextBlock Text="High AOID" />
                        <TextBox x:Name="HighId" MaxLength="10" AutomationProperties.Name="Observed high item template ID" />
                    </StackPanel>
                    <StackPanel Width="80" Margin="0,0,8,6">
                        <TextBlock Text="QL" />
                        <TextBox x:Name="Quality" MaxLength="5" AutomationProperties.Name="Observed quality level" />
                    </StackPanel>
                    <StackPanel Width="80" Margin="0,0,0,6">
                        <TextBlock Text="Quantity" />
                        <TextBox x:Name="Quantity" MaxLength="10" AutomationProperties.Name="Observed quantity" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Notes" Margin="0,2,0,0" />
                <TextBox x:Name="Notes" MaxLength="2048" Height="62" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Observation notes" />
                <CheckBox x:Name="ConfirmOpened" Content="I opened the corpse and manually associated this observation with the displayed NPC."
                          Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
