<Window x:Class="AORebirth.NpcEditor.NamedLootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Named loot tables" Width="1160" Height="760" MinWidth="835" MinHeight="535"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Style="{StaticResource EditorWindowStyle}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="265" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox x:Name="TableQuery" MaxLength="128" TextChanged="TableQuery_Changed" AutomationProperties.Name="Search named loot tables" />
                <TextBlock Text="Search name, ID, or category" Style="{StaticResource Caption}" Margin="0,3,0,6" />
                <WrapPanel>
                    <Button x:Name="NewTable" Content="New" Click="NewTable_Click" />
                    <Button x:Name="CopyTable" Content="Copy" Click="CopyTable_Click" />
                    <Button x:Name="DeleteTable" Content="Delete" Click="DeleteTable_Click" />
                </WrapPanel>
            </StackPanel>
            <DataGrid x:Name="Tables" SelectionChanged="Table_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Table" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <TabControl x:Name="Views" Grid.Column="1">
            <TabItem x:Name="DefinitionTab" Header="Definition">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="TableFields">
                            <TextBlock Text="Persistent table ID" Margin="0,0,0,3" />
                            <TextBox x:Name="TableId" MaxLength="64" AutomationProperties.Name="Persistent table ID" />
                            <TextBlock Text="Display name" Margin="0,8,0,3" />
                            <TextBox x:Name="TableName" MaxLength="128" AutomationProperties.Name="Loot table display name" />
                            <TextBlock Text="Category" Margin="0,8,0,3" />
                            <ComboBox x:Name="TableCategory" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Loot table category" />
                            <TextBlock Text="Description" Margin="0,8,0,3" />
                            <TextBox x:Name="TableDescription" Height="84" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Loot table description" />
                            <TextBlock Text="Evidence reference" Margin="0,8,0,3" />
                            <TextBox x:Name="TableEvidence" MaxLength="500" AutomationProperties.Name="Table evidence reference" />
                        </StackPanel>
                        <TextBlock x:Name="TableReferences" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Roll groups">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,5">
                            <Button x:Name="AddGroup" Content="Add group" Click="AddGroup_Click" />
                            <Button x:Name="RemoveGroup" Content="Remove" Click="RemoveGroup_Click" />
                        </WrapPanel>
                        <DataGrid Grid.Row="1" x:Name="Groups" SelectionChanged="Group_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Group" Binding="{Binding Id}" Width="*" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="2" Margin="0,8,0,5">
                            <Button x:Name="AddEntry" Content="Add entry" Click="AddEntry_Click" />
                            <Button x:Name="RemoveEntry" Content="Remove" Click="RemoveEntry_Click" />
                        </WrapPanel>
                        <DataGrid Grid.Row="3" x:Name="Entries" SelectionChanged="Entry_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Entry" Binding="{Binding Id}" Width="*" />
                                <DataGridTextColumn Header="Low ID" Binding="{Binding LowId}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="GroupFields">
                                <TextBlock Text="Selected group" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,6" Width="115">
                                                <TextBlock Text="Group ID" />
                                                <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Group ID" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="155">
                                        <TextBlock Text="Roll mode" />
                                        <ComboBox x:Name="GroupMode" SelectionChanged="GroupMode_SelectionChanged" SelectedItem="{Binding Mode, Mode=TwoWay}" AutomationProperties.Name="Roll mode" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="77">
                                                <TextBlock Text="Roll count" />
                                                <TextBox x:Name="GroupRollCount" Text="{Binding RollCount, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Roll count" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="80">
                                                <TextBlock Text="Chance (bp)" />
                                                <TextBox Text="{Binding ChanceBasisPoints, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Chance (bp)" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="93">
                                                <TextBlock Text="Empty weight" />
                                                <TextBox x:Name="GroupEmptyWeight" Text="{Binding EmptyWeight, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Empty weight" />
                                            </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,6" Width="94">
                                                <TextBlock Text="Min NPC level" />
                                                <TextBox Text="{Binding MinimumLevel, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Min NPC level" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,6" Width="94">
                                                <TextBlock Text="Max NPC level" />
                                                <TextBox Text="{Binding MaximumLevel, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Max NPC level" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,6" Width="118">
                                                <TextBlock Text="Playfield condition" />
                                                <TextBox Text="{Binding PlayfieldId, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Playfield condition" />
                                            </StackPanel>
                                            <CheckBox Content="Boss only" IsChecked="{Binding BossOnly}" />
                                </WrapPanel>
                                <TextBlock Text="10,000 basis points equals 100%. Weights apply among eligible outcomes." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Separator Margin="0,8" />
                            <StackPanel x:Name="EntryFields">
                                <TextBlock Text="Selected entry" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,6" Width="115">
                                                <TextBlock Text="Entry ID" />
                                                <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Entry ID" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="87">
                                                <TextBlock Text="Low AOID" />
                                                <TextBox Text="{Binding LowId, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Low AOID" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="87">
                                                <TextBlock Text="High AOID" />
                                                <TextBox Text="{Binding HighId, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="High AOID" />
                                            </StackPanel>
                                    <Button Content="Choose RDB item…" Click="PickEntryItem_Click" VerticalAlignment="Bottom" Margin="0,0,6,6" />
                                    <Button Content="Choose high endpoint…" Click="PickHighItem_Click" VerticalAlignment="Bottom" Margin="0,0,6,6" />
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,6" Width="74">
                                                <TextBlock Text="Min QL" />
                                                <TextBox Text="{Binding MinQuality, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Min QL" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="74">
                                                <TextBlock Text="Max QL" />
                                                <TextBox Text="{Binding MaxQuality, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Max QL" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="83">
                                                <TextBlock Text="Min quantity" />
                                                <TextBox Text="{Binding MinQuantity, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Min quantity" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="83">
                                                <TextBlock Text="Max quantity" />
                                                <TextBox Text="{Binding MaxQuantity, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Max quantity" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="80">
                                                <TextBlock Text="Chance (bp)" />
                                                <TextBox x:Name="EntryChance" Text="{Binding ChanceBasisPoints, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Chance (bp)" />
                                            </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="77">
                                                <TextBlock Text="Weight" />
                                                <TextBox x:Name="EntryWeight" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Weight" />
                                            </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox Content="NPC-level QL" IsChecked="{Binding LevelQuality}" />
                                    <CheckBox Content="Unique per corpse" IsChecked="{Binding UniquePerCorpse}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,6" Width="94">
                                                <TextBlock Text="Min NPC level" />
                                                <TextBox Text="{Binding MinimumLevel, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Min NPC level" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,6" Width="94">
                                                <TextBlock Text="Max NPC level" />
                                                <TextBox Text="{Binding MaximumLevel, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Max NPC level" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,6" Width="118">
                                                <TextBlock Text="Playfield condition" />
                                                <TextBox Text="{Binding PlayfieldId, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Playfield condition" />
                                            </StackPanel>
                                            <CheckBox Content="Boss only" IsChecked="{Binding BossOnly}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Width="180" Margin="0,0,8,6">
                                        <TextBlock Text="Evidence classification" />
                                        <ComboBox x:Name="EntryEvidence" SelectedItem="{Binding EvidenceClassification, Mode=TwoWay}"
                                                  AutomationProperties.Name="Entry evidence classification" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,6" Width="240">
                                                <TextBlock Text="Evidence reference" />
                                                <TextBox Text="{Binding EvidenceReference, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Evidence reference" />
                                            </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="AssignmentsTab" Header="Assignments">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="Assignments" SelectionChanged="Assignment_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Assignment" Binding="{Binding Id}" Width="*" />
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90" />
                            <DataGridTextColumn Header="Table" Binding="{Binding TableId}" Width="*" />
                            <DataGridTextColumn Header="Merge" Binding="{Binding Merge}" Width="85" />
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Row="1" MaxHeight="270" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel x:Name="AssignmentFields">
                            <WrapPanel>
                                <StackPanel Width="126" Margin="0,0,8,6">
                                    <TextBlock Text="Assignment ID" />
                                    <TextBox x:Name="AssignmentId" MaxLength="64" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Assignment ID" />
                                </StackPanel>
                                <StackPanel Width="128" Margin="0,0,8,6">
                                    <TextBlock Text="Scope" />
                                    <ComboBox x:Name="AssignmentScope" SelectedItem="{Binding Scope, Mode=TwoWay}" SelectionChanged="AssignmentScope_Changed"
                                              AutomationProperties.Name="Assignment scope" />
                                </StackPanel>
                                <StackPanel Width="95" Margin="0,0,8,6">
                                    <TextBlock Text="Merge" />
                                    <ComboBox x:Name="AssignmentMerge" SelectedItem="{Binding Merge, Mode=TwoWay}" SelectionChanged="AssignmentScope_Changed"
                                              AutomationProperties.Name="Assignment merge behavior" />
                                </StackPanel>
                                <StackPanel Width="147" Margin="0,0,8,6">
                                    <TextBlock Text="Table ID" />
                                    <ComboBox x:Name="AssignmentTable" IsEditable="True" Text="{Binding TableId, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="Assigned table ID" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6" Width="77">
                                                <TextBlock Text="Priority" />
                                                <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" AutomationProperties.Name="Priority" />
                                            </StackPanel>
                            </WrapPanel>
                            <WrapPanel x:Name="AssignmentTargets">
                                <StackPanel Margin="0,0,8,6" Width="100">
                                                <TextBlock Text="Family hash" />
                                                <TextBox x:Name="FamilyHashInput" Text="{Binding FamilyHash, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Family hash" />
                                            </StackPanel>
                                <StackPanel Margin="0,0,8,6" Width="105">
                                                <TextBlock Text="Template hash" />
                                                <TextBox x:Name="TemplateHashInput" Text="{Binding TemplateHash, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Template hash" />
                                            </StackPanel>
                                <StackPanel Margin="0,0,8,6" Width="76">
                                                <TextBlock Text="Band index" />
                                                <TextBox x:Name="BandIndexInput" Text="{Binding BandIndex, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Band index" />
                                            </StackPanel>
                                <StackPanel Margin="0,0,8,6" Width="80">
                                                <TextBlock Text="Playfield ID" />
                                                <TextBox x:Name="TargetPlayfieldInput" Text="{Binding PlayfieldId, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Playfield ID" />
                                            </StackPanel>
                                <StackPanel Margin="0,0,8,6" Width="96">
                                                <TextBlock Text="Authored index" />
                                                <TextBox x:Name="AuthoredIndexInput" Text="{Binding AuthoredIndex, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Authored index" />
                                            </StackPanel>
                                <Button x:Name="ChooseAssignmentTarget" Content="Find target…" Click="ChooseAssignmentTarget_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock x:Name="AssignmentTargetStatus" Style="{StaticResource Caption}" />
                            <WrapPanel x:Name="AssignmentMergeFields">
                                <StackPanel Margin="0,0,8,6" Width="155">
                                                <TextBlock Text="Target table/group" />
                                                <TextBox Text="{Binding TargetGroup, UpdateSourceTrigger=PropertyChanged}" MaxLength="129" AutomationProperties.Name="Target table/group" />
                                            </StackPanel>
                                <StackPanel Margin="0,0,8,6" Width="155">
                                                <TextBlock Text="Replacement group ID" />
                                                <TextBox x:Name="ReplacementGroupInput" Text="{Binding SourceGroupId, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Replacement group ID" />
                                            </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <StackPanel Margin="0,0,8,6" Width="94">
                                                <TextBlock Text="Min NPC level" />
                                                <TextBox Text="{Binding MinimumLevel, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Min NPC level" />
                                            </StackPanel>
                                <StackPanel Margin="0,0,8,6" Width="94">
                                                <TextBlock Text="Max NPC level" />
                                                <TextBox Text="{Binding MaximumLevel, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Max NPC level" />
                                            </StackPanel>
                                <StackPanel Margin="0,0,8,6" Width="118">
                                                <TextBlock Text="Playfield condition" />
                                                <TextBox Text="{Binding ConditionPlayfieldId, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Playfield condition" />
                                            </StackPanel>
                                <CheckBox Content="Boss only" IsChecked="{Binding BossOnly}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="2" Margin="0,5,0,0">
                        <Button x:Name="NewAssignment" Content="New assignment" Click="NewAssignment_Click" />
                        <Button x:Name="PreviewAssignment" Content="Preview Changes" Click="PreviewAssignment_Click" />
                        <Button x:Name="SaveAssignment" Content="Save assignment" Click="SaveAssignment_Click" />
                        <Button x:Name="DeleteAssignment" Content="Delete assignment" Click="DeleteAssignment_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Revision history">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="RestoreRegistry" Content="Restore selected registry revision" Click="RestoreRegistry_Click" />
                        <Button x:Name="RestorePreviousRegistry" Content="Restore previous" Click="RestorePreviousRegistry_Click" />
                    </WrapPanel>
                    <DataGrid x:Name="RegistryHistory" SelectionChanged="RegistryHistory_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="80" />
                            <DataGridTextColumn Header="UTC" Binding="{Binding AtUtc, StringFormat=u}" Width="160" />
                            <DataGridTextColumn Header="GM" Binding="{Binding Actor}" Width="*" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshRegistry" Content="Refresh" Click="RefreshRegistry_Click" />
                <Button x:Name="SaveTable" Content="Save table" Click="SaveTable_Click" />
                <Button x:Name="CloseDialog" Content="Close" IsCancel="True" Margin="0" />
            </StackPanel>
            <TextBlock x:Name="NamedLootStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
