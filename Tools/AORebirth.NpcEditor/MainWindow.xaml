<Window x:Class="AORebirth.NpcEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AORebirth NPC Editor" Width="1320" Height="860" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource EditorWindowStyle}">
    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="AORebirth NPC Editor" FontSize="29" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Caption}" Text="ZoneEngine administration · spawned NPCs and template loot" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Caption}" Text="Local port" />
                    <TextBox x:Name="Port" Text="7591" MaxLength="5" AutomationProperties.Name="Local HTTPS port" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Caption}" Text="GM account" />
                    <TextBox x:Name="UserName" MaxLength="128" AutomationProperties.Name="GM account" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Caption}" Text="GM password" />
                    <PasswordBox x:Name="Password" MaxLength="256" AutomationProperties.Name="GM password" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Caption}" Text="SHA-256 fingerprint from ZoneEngine startup" />
                    <TextBox x:Name="Fingerprint" MaxLength="64" AutomationProperties.Name="ZoneEngine certificate fingerprint" />
                </StackPanel>
                <Button x:Name="ConnectButton" Grid.Column="4" VerticalAlignment="Bottom" Content="Connect" Click="Connect_Click" />
            </Grid>
        </Border>

        <Grid x:Name="Workspace" Grid.Row="2" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="250" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Find" Click="Search_Click" Margin="6,0,0,0" />
                    <TextBox x:Name="NpcQuery" AutomationProperties.Name="NPC search" MaxLength="128" KeyDown="NpcQuery_KeyDown" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,6,0,8">
                    <TextBlock Style="{StaticResource Caption}" Text="Search name, template, hash, MonsterData, or playfield." />
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox x:Name="FollowTarget" Content="Follow local AOSharp" Checked="Follow_Changed" Unchecked="Follow_Changed"
                                  ToolTip="Enable only when the AO client is connected to this same local ZoneEngine." />
                        <CheckBox x:Name="LockNpc" Content="Lock NPC" Checked="Lock_Changed" Unchecked="Lock_Changed" IsEnabled="False" />
                    </WrapPanel>
                    <TextBlock x:Name="BridgeStatus" Style="{StaticResource Caption}" Text="Manual selection" />
                </StackPanel>
                <DataGrid Grid.Row="2" x:Name="NpcGrid" SelectionChanged="Npc_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Spawned NPC" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="43" />
                        <DataGridTextColumn Header="PF" Binding="{Binding ClientPlayfieldId}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource Line}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Browse items…" Click="BrowseItems_Click" />
                    <Button x:Name="RefreshDetail" DockPanel.Dock="Right" Content="Refresh NPC" Click="RefreshDetail_Click" IsEnabled="False" />
                    <StackPanel>
                        <TextBlock x:Name="DetailHeading" Text="Select a spawned NPC" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailIdentity" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>

                <TabControl x:Name="Details" Grid.Row="1" IsEnabled="False">
                    <TabItem Header="Overview">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="Overview" TextWrapping="Wrap" />
                                <TextBlock Text="Uploaded nanos" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <TextBlock x:Name="UploadedNanos" Style="{StaticResource Caption}" />
                                <TextBlock Text="Active nanos" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <TextBlock x:Name="ActiveNanos" Style="{StaticResource Caption}" />
                                <TextBlock Text="AI configuration" FontWeight="SemiBold" Margin="0,16,0,4" />
                                <TextBlock x:Name="Brain" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="StatsTab" Header="Stats">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="10,5,0,0" Text="Runtime values and configured template values" />
                                <TextBox x:Name="StatQuery" MaxLength="128" TextChanged="StatQuery_Changed" AutomationProperties.Name="Filter stats by name or ID" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" x:Name="StatsGrid" SelectionChanged="Stat_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Stat" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="ID" Binding="{Binding StatId}" Width="55" />
                                    <DataGridTextColumn Header="Base" Binding="{Binding RuntimeBase}" Width="75" />
                                    <DataGridTextColumn Header="Bonus" Binding="{Binding RuntimeBonus}" Width="75" />
                                    <DataGridTextColumn Header="Effective" Binding="{Binding RuntimeValue}" Width="80" />
                                    <DataGridTextColumn Header="Configured" Binding="{Binding ConfiguredValue}" Width="95" />
                                    <DataGridCheckBoxColumn Header="Editable" Binding="{Binding Editable, Mode=OneWay}" Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <WrapPanel>
                                    <TextBox x:Name="NewStatBase" Width="95" MaxLength="11" Margin="0,0,6,0" AutomationProperties.Name="New runtime base value" />
                                    <Button x:Name="ApplyStat" Content="Apply Live" Click="ApplyStat_Click" />
                                    <Button x:Name="RevertStatDraft" Content="Revert draft" Click="RevertStatDraft_Click" />
                                    <Button Content="Save stats to GameData" IsEnabled="False" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Text="Select an editable stat and lock the NPC to apply its new base value. Live edits last until the NPC despawns. Persistent stat editing is unavailable." />
                                <TextBlock x:Name="StatsStatus" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Loot">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TabControl x:Name="LootTabs" SelectionChanged="LootTab_SelectionChanged">
                                <TabItem x:Name="EffectiveLootTab" Header="Selected NPC">
                                    <DockPanel Margin="8">
                                        <TextBlock x:Name="EffectiveLootStatus" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                        <DataGrid x:Name="EffectiveLoot" SelectionChanged="LootRow_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Definition" Binding="{Binding Source}" Width="140" />
                                                <DataGridTextColumn Header="Items" Binding="{Binding ItemNames}" Width="2*" />
                                                <DataGridTextColumn Header="Chance %" Binding="{Binding Chance}" Width="75" />
                                                <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityRange}" Width="70" />
                                                <DataGridTextColumn Header="QL" Binding="{Binding QualityRange}" Width="80" />
                                                <DataGridTextColumn Header="Roll behavior" Binding="{Binding Behavior}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem x:Name="SavedLootTab" Header="Template band">
                                    <DockPanel Margin="8">
                                        <TextBlock x:Name="SavedLootStatus" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                        <DataGrid x:Name="SavedLoot" SelectionChanged="LootRow_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Definition" Binding="{Binding Source}" Width="140" />
                                                <DataGridTextColumn Header="Items" Binding="{Binding ItemNames}" Width="2*" />
                                                <DataGridTextColumn Header="Chance %" Binding="{Binding Chance}" Width="75" />
                                                <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityRange}" Width="70" />
                                                <DataGridTextColumn Header="QL" Binding="{Binding QualityRange}" Width="80" />
                                                <DataGridTextColumn Header="Roll behavior" Binding="{Binding Behavior}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="History">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Selected NPC changes" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <DataGrid x:Name="LiveLootHistory" Grid.Row="1" SelectionChanged="LootHistory_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="UTC" Binding="{Binding AtUtc, StringFormat=u}" Width="155" />
                                                <DataGridTextColumn Header="GM" Binding="{Binding Actor}" Width="*" />
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90" />
                                                <DataGridTextColumn Header="Before" Binding="{Binding BeforeText}" Width="*" />
                                                <DataGridTextColumn Header="After" Binding="{Binding AfterText}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button x:Name="RevertLiveLoot" Grid.Row="2" Content="Undo selected live change" Click="RevertLiveLoot_Click"
                                                HorizontalAlignment="Left" Margin="0,6,0,6" />
                                        <TextBlock Grid.Row="3" Text="Saved template band revisions" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <DataGrid x:Name="LootHistory" Grid.Row="4" SelectionChanged="LootHistory_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="75" />
                                                <DataGridTextColumn Header="UTC" Binding="{Binding AtUtc, StringFormat=u}" Width="155" />
                                                <DataGridTextColumn Header="GM" Binding="{Binding Actor}" Width="*" />
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                                                <DataGridTextColumn Header="Entries" Binding="{Binding EntryCount}" Width="75" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBox x:Name="LootHistoryDetails" Grid.Row="5" IsReadOnly="True" Height="64" Margin="0,6,0,0"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Saved loot change scope and values" />
                                        <WrapPanel Grid.Row="6" Margin="0,6,0,0">
                                            <Button x:Name="RestoreLootRevision" Content="Restore selected revision" Click="RestoreLootRevision_Click" />
                                            <Button x:Name="RevertLoot" Content="Restore previous" Click="RevertLoot_Click" />
                                        </WrapPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Simulation">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <WrapPanel>
                                            <TextBlock Text="Simulated corpses" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="LootRollCount" Text="100" Width="65" MaxLength="5" Margin="0,0,6,0"
                                                     AutomationProperties.Name="Simulation roll count" />
                                            <Button x:Name="SimulateLoot" Content="Simulate selected NPC" Click="SimulateLoot_Click" />
                                        </WrapPanel>
                                        <TextBlock x:Name="LootSimulationStatus" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,6,0,6"
                                                   Text="Simulated frequencies use the current live loot definition. No corpse or persistent item is created." />
                                        <DataGrid x:Name="LootSimulationGrid" Grid.Row="2">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                                                <DataGridTextColumn Header="Low ID" Binding="{Binding LowId}" Width="70" />
                                                <DataGridTextColumn Header="High ID" Binding="{Binding HighId}" Width="70" />
                                                <DataGridTextColumn Header="Drops" Binding="{Binding TotalDrops}" Width="60" />
                                                <DataGridTextColumn Header="Corpses" Binding="{Binding CorpsesWithItem}" Width="65" />
                                                <DataGridTextColumn Header="Observed %" Binding="{Binding CorpseFrequencyPercent, StringFormat=F2}" Width="85" />
                                                <DataGridTextColumn Header="QL × count" Binding="{Binding QualityDistribution}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                            <StackPanel x:Name="LootDraft" Grid.Row="1" Margin="0,6,0,0">
                                <TextBox x:Name="EffectiveLootRow" IsReadOnly="True" Height="58" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected loot entry details" />
                                <WrapPanel Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                        <TextBlock Text="Item family or group hash" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox x:Name="LootItemHash" Width="155" MaxLength="64"
                                                 AutomationProperties.Name="Item family or group hash" />
                                    </StackPanel>
                                    <Button x:Name="PickLootItem" Content="Choose item…" Click="PickLootItem_Click" />
                                    <Button x:Name="NewLootRow" Content="Add entry" Click="NewLootRow_Click" />
                                    <Button x:Name="RemoveLoot" Content="Stage removal" Click="RemoveLoot_Click" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="Chance %" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="LootChance" Width="47" MaxLength="3" Margin="0,0,8,0" AutomationProperties.Name="Loot chance percent" />
                                    <TextBlock Text="Attempts" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="LootRepeats" Width="42" MaxLength="2" Margin="0,0,8,0" AutomationProperties.Name="Loot roll attempts" />
                                    <TextBlock Text="QL variance %" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="LootVariance" Width="47" MaxLength="3" Margin="0,0,8,0" AutomationProperties.Name="Loot quality variance percent" />
                                    <TextBlock Text="Or QL range" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="LootMinQuality" Width="47" MaxLength="10" AutomationProperties.Name="Minimum loot QL" />
                                    <TextBlock Text="–" VerticalAlignment="Center" Margin="4,0" />
                                    <TextBox x:Name="LootMaxQuality" Width="47" MaxLength="10" AutomationProperties.Name="Maximum loot QL" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button x:Name="ApplyLoot" Content="Apply Live" Click="ApplyLoot_Click" />
                                    <Button x:Name="SaveLoot" Content="Save to GameData" Click="SaveLoot_Click" />
                                    <Button x:Name="RevertLootDraft" Content="Revert draft" Click="RevertLootDraft_Click" />
                                    <TextBlock x:Name="LootDraftStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Equipment">
                        <TabControl Margin="8">
                            <TabItem Header="Loadouts">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Selected NPC equipment" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <DataGrid Grid.Row="1" x:Name="EquipmentGrid" SelectionChanged="Equipment_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="55" />
                                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="QL" Binding="{Binding Quality}" Width="55" />
                                            <DataGridTextColumn Header="Low ID" Binding="{Binding LowId}" Width="70" />
                                            <DataGridTextColumn Header="High ID" Binding="{Binding HighId}" Width="70" />
                                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                                            <DataGridTextColumn Header="Position" Binding="{Binding DefaultPosition}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                        <WrapPanel>
                                            <Button x:Name="ReplaceEquipment" Content="Replace item…" Click="ReplaceEquipment_Click" />
                                            <Button x:Name="RemoveEquipment" Content="Remove item" Click="RemoveEquipment_Click" />
                                            <Button x:Name="AddArmor" Content="Add armor…" Click="AddArmor_Click" />
                                            <Button x:Name="ApplyEquipment" Content="Apply Live" Click="ApplyEquipment_Click" />
                                            <Button x:Name="RevertEquipmentDraft" Content="Revert draft" Click="RevertEquipmentDraft_Click" />
                                        </WrapPanel>
                                        <TextBlock x:Name="LiveEquipmentDraftStatus" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,10,0,5">
                                        <TextBlock Text="Configured template equipment" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SavedEquipmentStatus" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <DataGrid Grid.Row="4" x:Name="ConfiguredEquipmentGrid" SelectionChanged="Equipment_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Row" Binding="{Binding Index}" Width="55" />
                                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Low ID" Binding="{Binding LowId}" Width="90" />
                                            <DataGridTextColumn Header="High ID" Binding="{Binding HighId}" Width="90" />
                                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                                            <DataGridTextColumn Header="Position" Binding="{Binding DefaultPosition}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="5" Margin="0,6,0,0">
                                        <WrapPanel>
                                            <Button x:Name="ReplaceSavedEquipment" Content="Replace item…" Click="ReplaceSavedEquipment_Click" />
                                            <Button x:Name="RemoveSavedEquipment" Content="Remove item" Click="RemoveSavedEquipment_Click" />
                                            <Button x:Name="AddSavedArmor" Content="Add armor…" Click="AddSavedArmor_Click" />
                                            <Button x:Name="SaveEquipment" Content="Save to GameData" Click="SaveEquipment_Click" />
                                            <Button x:Name="RevertSavedEquipmentDraft" Content="Revert draft" Click="RevertSavedEquipmentDraft_Click" />
                                        </WrapPanel>
                                        <TextBlock x:Name="SavedEquipmentDraftStatus" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Saved history">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="EquipmentHistory" SelectionChanged="EquipmentHistory_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="75" />
                                            <DataGridTextColumn Header="UTC" Binding="{Binding AtUtc, StringFormat=u}" Width="155" />
                                            <DataGridTextColumn Header="GM" Binding="{Binding Actor}" Width="*" />
                                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBox x:Name="EquipmentHistoryDetails" Grid.Row="1" IsReadOnly="True" Height="90" Margin="0,6,0,0"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Equipment change before and after" />
                                    <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                        <Button x:Name="RestoreEquipmentRevision" Content="Restore selected revision" Click="RestoreEquipmentRevision_Click" />
                                        <Button x:Name="RestorePreviousEquipment" Content="Restore previous" Click="RestorePreviousEquipment_Click" />
                                    </WrapPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Live history">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="ChangesGrid" SelectionChanged="Change_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="UTC" Binding="{Binding AtUtc, StringFormat=u}" Width="165" />
                                    <DataGridTextColumn Header="Change" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="GM" Binding="{Binding Actor}" Width="100" />
                                    <DataGridCheckBoxColumn Header="Reverted" Binding="{Binding Reverted, Mode=OneWay}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Grid.Row="1" x:Name="LiveChangeDetails" IsReadOnly="True" Height="80" Margin="0,8,0,0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Live change scope and values" />
                            <Button Grid.Row="2" x:Name="RevertChange" Content="Revert selected live change" Click="RevertChange_Click"
                                    Margin="0,8,0,0" HorizontalAlignment="Left" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="4" Padding="10,7" Margin="0,10,0,0">
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" Text="Connect to an enabled local ZoneEngine endpoint." />
        </Border>
    </Grid>
</Window>
