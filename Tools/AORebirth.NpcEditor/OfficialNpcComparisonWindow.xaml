<Window x:Class="AORebirth.NpcEditor.OfficialNpcComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare AORebirth NPC definitions" Width="1050" Height="670" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource EditorWindowStyle}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Observation" Style="{StaticResource Caption}" Margin="0,0,0,8" />
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <WrapPanel>
                <Button x:Name="ChooseCatalog" Content="Open NpcTemplates.json…" Click="ChooseCatalog_Click" />
                <TextBlock Text="Template hash (optional)" VerticalAlignment="Center" Margin="6,0,6,0" />
                <TextBox x:Name="TemplateHash" Width="155" MaxLength="64" Margin="0,0,6,0"
                         AutomationProperties.Name="Exact AORebirth template hash" />
                <Button x:Name="CompareCatalog" Content="Find candidates" Click="CompareCatalog_Click" />
            </WrapPanel>
            <TextBlock x:Name="CatalogLabel" Style="{StaticResource Caption}" Margin="0,5,0,0" />
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="Candidates" Margin="0,0,0,8" SelectionChanged="Candidate_Changed"
                  AutomationProperties.Name="AORebirth template candidates">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hash" Binding="{Binding TemplateHash}" Width="1*" />
                <DataGridTextColumn Header="AORebirth NPC" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60" />
                <DataGridTextColumn Header="MonsterData" Binding="{Binding MonsterData}" Width="110" />
                <DataGridTextColumn Header="Match basis" Binding="{Binding Match}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Row="3" x:Name="ComparisonRows" AutomationProperties.Name="Selected candidate comparison">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="1.2*" />
                <DataGridTextColumn Header="Client observation" Binding="{Binding Observation}" Width="1.2*" />
                <DataGridTextColumn Header="Evidence source" Binding="{Binding ObservationSource}" Width="2*" />
                <DataGridTextColumn Header="AORebirth configured" Binding="{Binding Configured}" Width="1.4*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" IsCancel="True" Content="Close" Margin="6,0,0,0" />
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
