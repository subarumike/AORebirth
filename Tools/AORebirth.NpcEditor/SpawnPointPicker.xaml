<Window x:Class="AORebirth.NpcEditor.SpawnPointPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse authored spawn points" Width="760" Height="490" MinWidth="550" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Style="{StaticResource EditorWindowStyle}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="Loaded runtime playfield ID" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="PlayfieldId" Width="100" MaxLength="10" Margin="0,0,6,0" AutomationProperties.Name="Loaded runtime playfield ID" />
            <Button x:Name="FindPoints" Content="Find points" Click="FindPoints_Click" />
        </WrapPanel>
        <DataGrid Grid.Row="1" x:Name="Points" SelectionChanged="Points_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Authored index" Binding="{Binding AuthoredIndex}" Width="100" />
                <DataGridTextColumn Header="Spawn point" Binding="{Binding SpawnPointKey}" Width="*" />
                <DataGridTextColumn Header="Template" Binding="{Binding ConfiguredHash}" Width="*" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
                <DataGridTextColumn Header="Loaded" Binding="{Binding LoadedNpcs}" Width="65" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="PointStatus" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0" />
                <Button x:Name="ChoosePoint" DockPanel.Dock="Right" Content="Open selected point" Click="ChoosePoint_Click" />
                <Button x:Name="PreviousPoints" Content="Previous" Click="PreviousPoints_Click" />
                <Button x:Name="NextPoints" Content="Next" Click="NextPoints_Click" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
