<Project Sdk="Microsoft.NET.Sdk">
  <!-- Full Utility for the .NET 10 LoginEngine/ChatEngine build (ZoneEngine_New keeps its own trimmed projects). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Utility</AssemblyName>
    <RootNamespace>Utility</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>TRACE;AOREBIRTH_WIN_NET10;AOREBIRTH_WIN_NET10_ENGINES</DefineConstants>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS8632;CS0618;CS0612;SYSLIB0011;SYSLIB0014;SYSLIB0021;SYSLIB0023;SYSLIB0051</NoWarn>
    <AORebirthRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</AORebirthRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="MsgPack.Cli" Version="1.0.1" />
    <PackageReference Include="DotNetZip" Version="1.16.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SmokeLounge.AOtomation.Messaging.WinNet10.csproj" />
    <ProjectReference Include="Translations.Engines.WinNet10.csproj" />
  </ItemGroup>

  <Import Project="$(AORebirthRepositoryRoot)/SharedBuild/source-inventory/Utility.CompileItems.props" />
</Project>
