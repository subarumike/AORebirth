<Project Sdk="Microsoft.NET.Sdk">
  <!-- LoginEngine on .NET 10. Builds into AORebirth/Built/<Configuration>, where the start/stop scripts expect it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <OutDir>$(MSBuildThisFileDirectory)../../AORebirth/Built/$(Configuration)/</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>$(MSBuildThisFileDirectory)../../AORebirth/Server/LoginEngine/login.ico</ApplicationIcon>
    <AssemblyName>LoginEngine</AssemblyName>
    <RootNamespace>LoginEngine</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>TRACE;AOREBIRTH_WIN_NET10;AOREBIRTH_WIN_NET10_ENGINES</DefineConstants>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS8632;CS0618;CS0612;SYSLIB0011;SYSLIB0014;SYSLIB0021;SYSLIB0023;SYSLIB0051</NoWarn>
    <AORebirthRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</AORebirthRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SmokeLounge.AOtomation.Messaging.WinNet10.csproj" />
    <ProjectReference Include="Cell.Core.ZoneNew.WinNet10.csproj" />
    <ProjectReference Include="AORebirth.Core.Engines.WinNet10.csproj" />
    <ProjectReference Include="AORebirth.Database.Engines.WinNet10.csproj" />
    <ProjectReference Include="AORebirth.Interfaces.Engines.WinNet10.csproj" />
    <ProjectReference Include="Translations.Engines.WinNet10.csproj" />
    <ProjectReference Include="Utility.Engines.WinNet10.csproj" />
  </ItemGroup>

  <Import Project="$(AORebirthRepositoryRoot)/SharedBuild/source-inventory/LoginEngine.CompileItems.props" />

  <ItemGroup>
    <Content Include="$(AORebirthRepositoryRoot)/AORebirth/Config/Config.xml" Link="Config.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
