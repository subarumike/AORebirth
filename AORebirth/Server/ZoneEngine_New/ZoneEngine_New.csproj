<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ZoneEngine_New</AssemblyName>
    <RootNamespace>ZoneEngine_New</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>TRACE;AOREBIRTH_WIN_NET10</DefineConstants>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AORebirthRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</AORebirthRepositoryRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\..\Built\Debug\ZoneEngine_New\</OutputPath>
    <DefineConstants>DEBUG;TRACE;AOREBIRTH_WIN_NET10</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\..\Built\Release\ZoneEngine_New\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AODB" Version="1.0.6" />
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.25" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="MsgPack.Cli" Version="1.0.1" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="NLog" Version="6.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Libraries/Source/AORebirth.Database.Schema/AORebirth.Database.Schema.csproj" />
    <ProjectReference Include="../../Libraries/Source/AORebirth.World.Package/AORebirth.World.Package.csproj" />
    <ProjectReference Include="$(AORebirthRepositoryRoot)/WindowsBuildNet10/Projects/SmokeLounge.AOtomation.Messaging.WinNet10.csproj" />
    <ProjectReference Include="$(AORebirthRepositoryRoot)/WindowsBuildNet10/Projects/AORebirth.Core.ZoneNew.WinNet10.csproj" />
    <ProjectReference Include="$(AORebirthRepositoryRoot)/WindowsBuildNet10/Projects/Utility.ZoneNew.WinNet10.csproj" />
    <ProjectReference Include="$(AORebirthRepositoryRoot)/WindowsBuildNet10/Projects/AORebirth.Communication.ZoneNew.WinNet10.csproj" />
  </ItemGroup>

  <!-- Sources under this directory are globbed by the SDK. Only the shared assembly info,
       which lives outside the project cone, needs an explicit entry. -->
  <ItemGroup>
    <!-- Shared evidence-only placement validation, not legacy runtime ownership. -->
    <Compile Include="../../Libraries/Source/AORebirth.Database/Dao/CharacterOnlineOwnershipGuard.cs" Link="Shared/CharacterOnlineOwnershipGuard.cs" />
    <Compile Include="../ZoneEngine/Core/Playfields/OfficialPlacements/OfficialPlayfieldPlacement.cs" Link="OfficialPlacements/OfficialPlayfieldPlacement.cs" />
    <Compile Include="../ZoneEngine/Core/Playfields/OfficialPlacements/OfficialPlayfieldPlacementCatalog.cs" Link="OfficialPlacements/OfficialPlayfieldPlacementCatalog.cs" />
    <Compile Include="$(AORebirthRepositoryRoot)/LinuxBuild/Compatibility/ZoneEngine/JavaScriptSerializer.Linux.cs" Link="Compatibility/JavaScriptSerializer.cs" />
    <Compile Include="..\..\SolutionAssemblyInfo.cs">
      <Link>Properties\SolutionAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

    <ItemGroup>
    <Content Include="$(AORebirthRepositoryRoot)/docs/generated/playfields/official-placement-corpus-manifest.json;$(AORebirthRepositoryRoot)/docs/generated/playfields/official-placement-index.json;$(AORebirthRepositoryRoot)/docs/generated/playfields/official-placement-summary.json;$(AORebirthRepositoryRoot)/docs/generated/playfields/official-acghash-inventory.json;$(AORebirthRepositoryRoot)/docs/generated/playfields/playfield-package-manifest.json">
      <Link>Content/Official/PlayfieldPlacements/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(AORebirthRepositoryRoot)/docs/generated/playfields/placements/pf_*.json">
      <Link>Content/Official/PlayfieldPlacements/placements/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\Config\Config.xml">
      <Link>Config.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Libraries\Source\AORebirth.Database\Migrations\*.sql" Exclude="..\..\Libraries\Source\AORebirth.Database\Migrations\*account*">
      <Link>Migrations\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Libraries\Source\AORebirth.Database\SqlTables\*.sql">
      <Link>SqlTables\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Full GameData tree (items.dat, MobTemplates, Playfields metadata/spawns). -->
    <Content Include="..\..\GameData\**\*">
      <Link>GameData\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\EventType.cs">
      <Link>Enums\EventType.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\ActionType.cs">
      <Link>Enums\ActionType.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\Operator.cs">
      <Link>Enums\Operator.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\ItemTarget.cs">
      <Link>Enums\ItemTarget.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\ItemClass.cs">
      <Link>Enums\ItemClass.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\ItemSource.cs">
      <Link>Enums\ItemSource.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\ItemFlags.cs">
      <Link>Enums\ItemFlags.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\WeaponSlots.cs">
      <Link>Enums\WeaponSlots.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\WeaponFlags.cs">
      <Link>Enums\WeaponFlags.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\MeshLayer.cs">
      <Link>Enums\MeshLayer.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\CanFlags.cs">
      <Link>Enums\CanFlags.cs</Link>
    </Compile>
    <Compile Include="..\..\Libraries\Source\AORebirth.Enums\FunctionType.cs">
      <Link>Enums\FunctionType.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
