    {
      "Id": "annoying_dude_796360BD",
      "NpcIdentity": "SimpleChar:796360BD",
      "Name": "Annoying Dude",
      "RootNodeId": "annoying_223626_001",
      "Aliases": [],
      "Nodes": [
        { "Id": "annoying_223626_001", "PromptText": "Yo!", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "annoying_001_0", "Index": 0, "Text": "I'm here to make sure you don't bother Karrec again.", "TextEvidence": "20260717-223626", "NextNodeId": "annoying_223626_002", "Conditions": [], "Actions": [] }, { "Id": "annoying_001_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "annoying_223626_002", "PromptText": "I would never do such thing!", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "annoying_002_0", "Index": 0, "Text": "Enough lies, hand me your burger.", "TextEvidence": "20260717-223626", "NextNodeId": "annoying_223626_003", "Conditions": [], "Actions": [] }, { "Id": "annoying_002_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "annoying_223626_003", "PromptText": "You are nuts, come on! I'm hungry.", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "annoying_003_0", "Index": 0, "Text": "I will count to three...", "TextEvidence": "20260717-223626", "NextNodeId": "annoying_223626_004", "Conditions": [], "Actions": [] }, { "Id": "annoying_003_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "annoying_223626_004", "PromptText": "You will not have my burger!", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "annoying_004_0", "Index": 0, "Text": "1...", "TextEvidence": "20260717-223626", "NextNodeId": "annoying_223626_005", "Conditions": [], "Actions": [] }, { "Id": "annoying_004_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "annoying_223626_005", "PromptText": "I'm sure we can arrange some sort of agreement?", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "annoying_005_0", "Index": 0, "Text": "2...", "TextEvidence": "20260717-223626", "NextNodeId": "annoying_223626_006", "Conditions": [], "Actions": [] }, { "Id": "annoying_005_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "annoying_223626_006", "PromptText": "Come on, I'm skinny I need the calories...", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "annoying_006_0", "Index": 0, "Text": "3!", "TextEvidence": "20260717-223626", "NextNodeId": "annoying_223626_007", "Conditions": [], "Actions": [] }, { "Id": "annoying_006_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "annoying_223626_007", "PromptText": "Ok, ok, ok! Take it, it didn't taste that good anyway. Just leave me alone!", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "annoying_007_0", "Index": 0, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] }
      ],
