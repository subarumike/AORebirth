      "RootNodeId": "maddy_223626_001",
      "Aliases": [],
      "Nodes": [
        { "Id": "maddy_223626_001", "PromptText": "Hello there, young one.", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "maddy_001_0", "Index": 0, "Text": "I heard you have not donated any money to Karrec's cause.", "TextEvidence": "20260717-223626", "NextNodeId": "maddy_223626_002", "Conditions": [], "Actions": [] }, { "Id": "maddy_001_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "maddy_223626_002", "PromptText": "You should not mingle with people like him, child.", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "maddy_002_0", "Index": 0, "Text": "I am here to collect your donation. Who I mingle with is not your business.", "TextEvidence": "20260717-223626", "NextNodeId": "maddy_223626_003", "Conditions": [], "Actions": [] }, { "Id": "maddy_002_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "maddy_223626_003", "PromptText": "Well, now. You are one of those. I don't have the time or patience to deal with you. Get lost before I tell one of the peacekeepers what you are up to.", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "maddy_003_0", "Index": 0, "Text": "I kick peacekeeper butt for fun. Tell them and I will show you!", "TextEvidence": "20260717-223626", "NextNodeId": "maddy_223626_004", "Conditions": [], "Actions": [] }, { "Id": "maddy_003_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "maddy_223626_004", "PromptText": "I'm disappointed in you, child. I will give you my credit card if you leave me alone. Money is not worth risking anyone's life for. Not even yours.", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "maddy_004_0", "Index": 0, "Text": "I knew you would come to your senses, old woman.", "TextEvidence": "20260717-223626", "NextNodeId": "maddy_223626_005", "Conditions": [], "Actions": [] }, { "Id": "maddy_004_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] },
        { "Id": "maddy_223626_005", "PromptText": "Leave now, before I change my mind.", "PromptTextConfidence": "captured-exact", "Options": [ { "Id": "maddy_005_0", "Index": 0, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] } ], "EnterActions": [] }
