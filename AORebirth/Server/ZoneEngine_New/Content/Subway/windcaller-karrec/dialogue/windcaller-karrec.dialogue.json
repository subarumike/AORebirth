          "PromptText": null,
          "PromptTextConfidence": "no-append-text-observed",
          "Options": [
            { "Id": "karrec_return_0", "Index": 0, "Text": "I have the bronto burger and a donation to your temple", "TextEvidence": "20260717-223626", "NextNodeId": "karrec_223626_return_trade", "Conditions": [], "Actions": [] },
            { "Id": "karrec_return_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] }
          ],
          "EnterActions": []
        },
