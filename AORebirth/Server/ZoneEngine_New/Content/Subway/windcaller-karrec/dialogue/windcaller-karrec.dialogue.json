      "Nodes": [
        {
          "Id": "karrec_223626_001",
          "PromptText": "Greetings, traveller. My name is Karrec.\nWould you spare a moment of your precious time?",
          "PromptTextConfidence": "captured-exact",
          "Options": [
            { "Id": "karrec_001_0", "Index": 0, "Text": "You can have a moment, but no more.", "TextEvidence": "20260717-223626", "NextNodeId": "karrec_223626_002", "Conditions": [], "Actions": [] },
            { "Id": "karrec_001_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] }
          ],
          "EnterActions": []
        },
        {
          "Id": "karrec_223626_002",
          "PromptText": "I am but a humble servant carrying out his duties. But even servants need food once in a while...",
          "PromptTextConfidence": "captured-exact",
          "Options": [
            { "Id": "karrec_002_0", "Index": 0, "Text": "So, you want food?", "TextEvidence": "20260717-223626", "NextNodeId": "karrec_223626_003", "Conditions": [], "Actions": [] },
            { "Id": "karrec_002_1", "Index": 1, "Text": "A servant?", "TextEvidence": "20260717-223626-unselected", "NextNodeId": "close", "Conditions": [], "Actions": [] },
            { "Id": "karrec_002_2", "Index": 2, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] }
          ],
          "EnterActions": []
        },
        {
          "Id": "karrec_223626_003",
          "PromptText": "Yes, and of course any spare change...",
          "PromptTextConfidence": "captured-exact",
          "Options": [
            { "Id": "karrec_003_0", "Index": 0, "Text": "What will I get out of this?", "TextEvidence": "20260717-223626", "NextNodeId": "karrec_223626_004", "Conditions": [], "Actions": [] },
            { "Id": "karrec_003_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] }
          ],
          "EnterActions": []
        },
        {
          "Id": "karrec_223626_004",
          "PromptText": "I shall grant you access to the Temple of the Three Winds.",
          "PromptTextConfidence": "captured-exact",
          "Options": [
            { "Id": "karrec_004_0", "Index": 0, "Text": "Fine, tell me what to do.", "TextEvidence": "20260717-223626", "NextNodeId": "karrec_223626_005", "Conditions": [], "Actions": [] },
            { "Id": "karrec_004_1", "Index": 1, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] }
          ],
          "EnterActions": []
        },
        {
          "Id": "karrec_223626_005",
          "PromptText": "There is an annoying man that always eats his bronto burger in front of me.. You must find him and take his burger.\nSecondly, the rich old woman Maddy Cardile never donated any money to our cause. Force her to do so.",
          "PromptTextConfidence": "captured-exact",
          "Options": [
            { "Id": "karrec_005_0", "Index": 0, "Text": "I'll do it...", "TextEvidence": "20260717-223626", "NextNodeId": "karrec_223626_006", "Conditions": [], "Actions": [] },
            { "Id": "karrec_005_1", "Index": 1, "Text": "You are a scum, I will never help you.", "TextEvidence": "20260717-223626-unselected", "NextNodeId": "close", "Conditions": [], "Actions": [] },
            { "Id": "karrec_005_2", "Index": 2, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] }
          ],
          "EnterActions": []
        },
        {
          "Id": "karrec_223626_006",
          "PromptText": "Good, good. You know where to find me when you are done.",
          "PromptTextConfidence": "captured-exact",
          "Options": [
            { "Id": "karrec_006_0", "Index": 0, "Text": "Goodbye", "TextEvidence": "20260717-223626", "NextNodeId": "close", "Conditions": [], "Actions": [] }
          ],
