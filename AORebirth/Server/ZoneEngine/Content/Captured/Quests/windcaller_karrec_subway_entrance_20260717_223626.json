  "dialoguePaths": {
    "karrecAcceptance": [
      {"text": "Greetings, traveller. My name is Karrec.\nWould you spare a moment of your precious time?", "options": ["You can have a moment, but no more.", "Goodbye"], "selected": 0},
      {"text": "I am but a humble servant carrying out his duties. But even servants need food once in a while...", "options": ["So, you want food?", "A servant?", "Goodbye"], "selected": 0},
      {"text": "Yes, and of course any spare change...", "options": ["What will I get out of this?", "Goodbye"], "selected": 0},
      {"text": "I shall grant you access to the Temple of the Three Winds.", "options": ["Fine, tell me what to do.", "Goodbye"], "selected": 0},
      {"text": "There is an annoying man that always eats his bronto burger in front of me.. You must find him and take his burger.\nSecondly, the rich old woman Maddy Cardile never donated any money to our cause. Force her to do so.", "options": ["I'll do it...", "You are a scum, I will never help you.", "Goodbye"], "selected": 0},
      {"text": "Good, good. You know where to find me when you are done.", "options": ["Goodbye"], "selected": 0}
    ],
    "annoyingDude": [
      {"text": "Yo!", "options": ["I'm here to make sure you don't bother Karrec again.", "Goodbye"], "selected": 0},
      {"text": "I would never do such thing!", "options": ["Enough lies, hand me your burger.", "Goodbye"], "selected": 0},
      {"text": "You are nuts, come on! I'm hungry.", "options": ["I will count to three...", "Goodbye"], "selected": 0},
      {"text": "You will not have my burger!", "options": ["1...", "Goodbye"], "selected": 0},
      {"text": "I'm sure we can arrange some sort of agreement?", "options": ["2...", "Goodbye"], "selected": 0},
      {"text": "Come on, I'm skinny I need the calories...", "options": ["3!", "Goodbye"], "selected": 0},
      {"text": "Ok, ok, ok! Take it, it didn't taste that good anyway. Just leave me alone!", "options": [], "selected": null}
    ],
    "maddyCardile": [
      {"text": "Hello there, young one.", "options": ["I heard you have not donated any money to Karrec's cause.", "Goodbye"], "selected": 0},
      {"text": "You should not mingle with people like him, child.", "options": ["I am here to collect your donation. Who I mingle with is not your business.", "Goodbye"], "selected": 0},
      {"text": "Well, now. You are one of those. I don't have the time or patience to deal with you. Get lost before I tell one of the peacekeepers what you are up to.", "options": ["I kick peacekeeper butt for fun. Tell them and I will show you!", "Goodbye"], "selected": 0},
      {"text": "I'm disappointed in you, child. I will give you my credit card if you leave me alone. Money is not worth risking anyone's life for. Not even yours.", "options": ["I knew you would come to your senses, old woman.", "Goodbye"], "selected": 0},
      {"text": "Leave now, before I change my mind.", "options": [], "selected": null}
    ],
    "maddyAbortedOpen": {"text": "Hello there, young one.", "serverClosedBeforeOptions": true, "cause": null}
  },
