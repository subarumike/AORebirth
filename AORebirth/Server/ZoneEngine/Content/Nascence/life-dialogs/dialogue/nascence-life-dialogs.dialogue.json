      "Nodes": [
        {
          "Id": "fala_001",
          "PromptText": "I was wondering when our paths would cross.\n\nNow, finally, I can set you off on your journey.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText (opening lines)",
          "Options": [
            {
              "Id": "fala_001_option_0",
              "Index": 0,
              "Text": "Journey?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "fala_device_trade_hold",
              "Actions": []
            },
            {
              "Id": "fala_001_option_1",
              "Index": 1,
              "Text": "How did you know our paths would cross?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "fala_uncaptured",
              "Actions": []
            },
            {
              "Id": "fala_001_option_2",
              "Index": 2,
              "Text": "I don't need your help.",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "fala_uncaptured",
              "Actions": []
            },
            {
              "Id": "fala_001_option_3",
              "Index": 3,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "close",
              "Actions": [
                {
                  "Id": "fala_001_option_3_end",
                  "Type": "EndDialogue",
                  "QuestId": null,
                  "Text": "Safe close"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "fala_device_trade_hold",
          "PromptText": "You seek advice regarding an ancient device, correct?\n\nHe returns the item and nods.\n\nThere is no doubt in my mind that you are one of the Faithful.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText A2 + device inspect on How about this Ancient Artifact",
          "Options": [
            {
              "Id": "fala_device_trade_hold_option_0",
              "Index": 0,
              "Text": "(Continue after trade)",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "fala_002",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "fala_002",
          "PromptText": "The journey of enlightenment.\n\nA journey taken within, as much as around yourself.\n\nAnd I will set you off on your voyage, that you may understand the truth of this place.\n\nI know who may posses information regarding this ancient device and he can be found in the Garden of Aban.\n\nBut before I grant you passage there, you must answer me truthfully...\n\nAre you ready to take your first staggering strides towards redemption?",
          "PromptTextConfidence": "capture 20260822-224319 AppendText A3-A6 after Journey? (device inspect deferred to fala_003)",
          "Options": [
            {
              "Id": "fala_002_option_0",
              "Index": 0,
              "Text": "Yes, I am ready to seek the path of truth and compassion.",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "fala_003",
              "Actions": []
            },
            {
              "Id": "fala_002_option_1",
              "Index": 1,
              "Text": "I don't need your help.",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "fala_uncaptured",
              "Actions": []
            },
            {
              "Id": "fala_002_option_2",
              "Index": 2,
              "Text": "Can you tell me more about the Garden?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "fala_uncaptured",
              "Actions": []
            },
            {
              "Id": "fala_002_option_3",
              "Index": 3,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "close",
              "Actions": [
                {
                  "Id": "fala_002_option_3_end",
                  "Type": "EndDialogue",
                  "QuestId": null,
                  "Text": "Safe close"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "fala_003",
          "PromptText": "Then prove this to us.\n\nJust as the White Knight had to slay the unholy beast in the Days of Reckoning to show he was worthy of redemption, you must now complete a task to show us proof of your devotion to Aban.\n\nSearch for marks of Her existence here in Nascence, then bring what you find before me.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText after accept",
          "Options": [
            {
              "Id": "fala_003_option_0",
              "Index": 0,
              "Text": "How about this Ancient Artifact...",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "fala_device_trade_hold",
