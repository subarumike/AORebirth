          ],
          "EnterActions": []
        },
        {
          "Id": "fala_hub",
          "PromptText": "Welcome back, {player}.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText reopen",
          "Options": [
            {
              "Id": "fala_hub_option_0",
