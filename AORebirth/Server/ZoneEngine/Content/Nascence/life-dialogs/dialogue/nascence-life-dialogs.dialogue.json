              "NextNodeId": "close",
              "Actions": [
                {
                  "Id": "falker_002_option_0_end",
                  "Type": "EndDialogue",
                  "QuestId": null,
                  "Text": "Safe close"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
