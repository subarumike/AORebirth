    {
      "Id": "scientist-donna-red",
      "NpcIdentity": "SimpleChar:7A18D4B1",
      "Name": "Scientist Donna Red",
      "RootNodeId": "donna_001",
      "Aliases": [
        "(SimpleChar:7A18D4B1)"
      ],
      "Nodes": [
        {
          "Id": "donna_001",
          "PromptText": "Hi there! I am pleased to meet you ...?\n\nTelling Donna your name would be the expected formal response, even though she most likely already sees it on her holographic display.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [
            {
              "Id": "donna_001_option_0",
              "Index": 0,
              "Text": "My name is {player}.",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_002",
              "Actions": []
            },
            {
              "Id": "donna_001_option_1",
              "Index": 1,
              "Text": "My name is not of your concern.",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_name_decline",
              "Actions": []
            },
            {
              "Id": "donna_001_option_2",
              "Index": 2,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "close",
              "Actions": [
                {
                  "Id": "donna_001_option_2_end",
                  "Type": "EndDialogue",
                  "QuestId": null,
                  "Text": "Safe close"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_002",
          "PromptText": "Then I am pleased to meet you, {player}.\n\nHer sincere smile would make anyone relax in her presence.\n\nIs there anything I can do for you?",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [
            {
              "Id": "donna_002_option_0",
              "Index": 0,
              "Text": "I am wondering why we are required to wear this bracer?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_003",
              "Actions": []
            },
            {
              "Id": "donna_002_option_1",
              "Index": 1,
              "Text": "What are you doing here?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_004",
              "Actions": []
            },
            {
              "Id": "donna_002_option_2",
              "Index": 2,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "close",
              "Actions": [
                {
                  "Id": "donna_002_option_2_end",
                  "Type": "EndDialogue",
                  "QuestId": null,
                  "Text": "Safe close"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_003",
          "PromptText": "The bracer registers mutations in your DNA, so it is important to monitor the data on a frequent basis.\n\nWe must be able to act quickly if there is an unexpected increase in the spontaneous mutation frequency, both to prevent and to repair undesirable results on the subject.\n\nShe blushes a bit then corrects herself.\n\nThe subject would be you - of course.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [
            {
              "Id": "donna_003_option_0",
              "Index": 0,
              "Text": "What are you doing here?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_004",
              "Actions": []
            },
            {
              "Id": "donna_003_option_1",
              "Index": 1,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "close",
              "Actions": [
                {
                  "Id": "donna_003_option_1_end",
                  "Type": "EndDialogue",
                  "QuestId": null,
                  "Text": "Safe close"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_004",
          "PromptText": "I am assessing the effects of environmental contaminants on biological resources.\n\nThe threat of unexplainable contaminants to Rubi-Kan wildlife is being evaluated by data synthesis and field activities.\n\nI am coordinating the field activities here in Nascence, on behalf of the global environmental movement and animal rights organization Eco Warriors.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [
            {
              "Id": "donna_004_option_0",
              "Index": 0,
              "Text": "What can you tell me about Nascence?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_nascence_stub",
              "Actions": []
            },
            {
              "Id": "donna_004_option_1",
              "Index": 1,
              "Text": "How can the environment here in Nascence affect Rubi-Ka?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_005",
              "Actions": []
            },
            {
              "Id": "donna_004_option_2",
              "Index": 2,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "close",
              "Actions": [
                {
                  "Id": "donna_004_option_2_end",
                  "Type": "EndDialogue",
                  "QuestId": null,
                  "Text": "Safe close"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_005",
          "PromptText": "That is a very good question.\n\nWith a concerned look on her face she picks up an ancient looking device.\n\nStrange things are going on here.\n\nI keep finding these obscure objects.\n\nShe shows you the strange device from every angle then continues in awe.\n\nI have never seen anything like it before.\n\nI wish I knew what function or purpose these items had and who left them here.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [
            {
              "Id": "donna_005_option_0",
              "Index": 0,
              "Text": "Maybe I can help you?",
              "TextEvidence": "capture 20260822-224319; accepts Mission:55ABAD4D + Ancient Device 214998",
              "NextNodeId": "donna_006",
              "Actions": []
            },
            {
              "Id": "donna_005_option_1",
              "Index": 1,
              "Text": "Looks interesting, I'm sure you'll find out what it is.",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_decline",
              "Actions": []
            },
            {
              "Id": "donna_005_option_2",
              "Index": 2,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "close",
              "Actions": [
                {
                  "Id": "donna_005_option_2_end",
                  "Type": "EndDialogue",
                  "QuestId": null,
                  "Text": "Safe close"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_006",
          "PromptText": "Can you?!\n\nShe brightens up and almost drops the item out of excitement, then places it cautiously in your hands.\n\nI would really appreciate any information you find.\n\nAs she speaks her fingers nimbly move over the keys of her wrist-attached Intercom, most likely taking some notes from your conversation.\n\nAnything that would help us understand this place is of value, of course, but I have a feeling that these ancient artifacts could help answer many of our questions. And the settlement east of here may hold clues regarding these artifacts.\n\nWith that she smiles and gently pats your shoulder.\n\nThe bracer showed only nominal irregularities in your DNA, all within the allowed boundaries.\n\nYou should get going now, {player}. Good luck!",
          "PromptTextConfidence": "capture 20260822-224319 AppendText after QFU",
          "Options": [
            {
              "Id": "donna_006_option_0",
              "Index": 0,
              "Text": "What kind of rumors have you heard about Nascence?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_007",
              "Actions": []
            },
            {
              "Id": "donna_006_option_1",
              "Index": 1,
              "Text": "What can you tell me about the symbols you are investigating here?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_008",
              "Actions": []
            },
            {
              "Id": "donna_006_option_2",
              "Index": 2,
              "Text": "What can you tell me about the Brink?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_009",
              "Actions": []
            },
            {
              "Id": "donna_006_option_3",
              "Index": 3,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_010",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_hub",
          "PromptText": "Is there anything else I can help you with, {player}?",
          "PromptTextConfidence": "reopen hub after Mission:55ABAD4D accept; options match capture post-grant list",
          "Options": [
            {
              "Id": "donna_hub_option_0",
              "Index": 0,
              "Text": "What kind of rumors have you heard about Nascence?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_007",
              "Actions": []
            },
            {
              "Id": "donna_hub_option_1",
              "Index": 1,
              "Text": "What can you tell me about the symbols you are investigating here?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_008",
              "Actions": []
            },
            {
              "Id": "donna_hub_option_2",
              "Index": 2,
              "Text": "What can you tell me about the Brink?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_009",
              "Actions": []
            },
            {
              "Id": "donna_hub_option_3",
              "Index": 3,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_010",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_007",
          "PromptText": "I have heard that a settlement has been found east of here.\n\nThe settlement was supposed to be inhabited by beautiful creatures caring for the balance in nature.\n\nBut the only thing I found was the Brink and the Swamp. And most creatures there honestly don't fit that description.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [
            {
              "Id": "donna_007_option_0",
              "Index": 0,
              "Text": "What can you tell me about the symbols you are investigating here?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_008",
              "Actions": []
            },
            {
              "Id": "donna_007_option_1",
              "Index": 1,
              "Text": "What can you tell me about the Brink?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_009",
              "Actions": []
            },
            {
              "Id": "donna_007_option_2",
              "Index": 2,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_010",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_008",
          "PromptText": "They refer to someone well versed in the past. His title would be, directly translated, Sipius.\n\nThe one close in touch with the Divine entity is referred to as an Ecclesiast.\n\nBut these are all directly translated titles and my knowledge of the ancient alphabet is limited, so please keep a margin for errors.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [
            {
              "Id": "donna_008_option_0",
              "Index": 0,
              "Text": "What can you tell me about the Brink?",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_009",
              "Actions": []
            },
            {
              "Id": "donna_008_option_1",
              "Index": 1,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_010",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_009",
          "PromptText": "Well, the Brink can be found North of here.\n\nBut since seismic readings from that area are not reliable, you would be wise to keep away.\n\nThe Brink is the very edge of these lands, but I have reached the conclusion that something is causing the edge to dissolve.\n\nI hope Drake Rodriguez can find a solution to this problem soon or we will be in serious danger out here.",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [
            {
              "Id": "donna_009_option_0",
              "Index": 0,
              "Text": "Goodbye",
              "TextEvidence": "capture 20260822-224319",
              "NextNodeId": "donna_010",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "donna_010",
          "PromptText": "Take care!",
          "PromptTextConfidence": "capture 20260822-224319 AppendText",
          "Options": [],
          "EnterActions": [
            {
              "Id": "donna_010_end",
              "Type": "EndDialogue",
              "QuestId": null,
              "Text": "Close after Take care"
            }
          ]
        },
        {
          "Id": "donna_name_decline",
          "PromptText": "As you wish. If you change your mind, I am still here.",
          "PromptTextConfidence": "stub; decline-name branch body not selected in 20260822-224319",
