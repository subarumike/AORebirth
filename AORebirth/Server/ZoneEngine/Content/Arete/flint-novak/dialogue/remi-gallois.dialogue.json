            }
          ],
          "EnterActions": []
        },
        {
          "Id": "remi_offer_001",
          "PromptText": "Don't worry, It's easy. There's a group of lowlife gangbangers out there that managed to get ahold of some serious hardware. Someone left some stray mech activation codes laying around somewhere and these a-holes got ahold of it. Been running around acting like little brats ever since.\n\nThe  Hellfyre Rocket Launcher is designed to remove unwanted bipedal mechanized war machines. So, are you in?",
          "PromptTextConfidence": "KnubotAppendText 20260727-204902 18:49:24.612",
          "Options": [
            {
              "Id": "remi_offer_001_option_0",
              "Index": 0,
              "Text": "I guess I could do that...",
              "TextEvidence": "KnuBotAnswerList 2026-07-27T18:49:24.6126599Z",
              "NextNodeId": "remi_accept_001",
              "Actions": []
            },
            {
              "Id": "remi_offer_001_option_1",
              "Index": 1,
              "Text": "You know, I think I'm going to have to pass...",
              "TextEvidence": "KnuBotAnswerList 2026-07-27T18:49:24.6126599Z",
              "NextNodeId": "remi_goodbye",
              "Actions": [
