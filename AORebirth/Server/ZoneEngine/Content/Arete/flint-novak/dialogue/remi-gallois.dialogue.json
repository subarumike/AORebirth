          "Options": [
            {
              "Id": "remi_work_001_option_0",
              "Index": 0,
              "Text": "Wait, you want me to do what now?",
              "TextEvidence": "KnuBotAnswerList 2026-07-27T18:49:22.0622325Z",
              "NextNodeId": "remi_offer_001",
              "Actions": []
            },
            {
              "Id": "remi_work_001_option_1",
              "Index": 1,
