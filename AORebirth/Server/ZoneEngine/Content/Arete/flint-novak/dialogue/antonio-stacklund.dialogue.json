      "Nodes": [
        {
          "Id": "antonio_001",
          "PromptText": "Hello there, welcome to Rubi-Ka! Looking for an upgrade for your weapon? With my greatest creation, the Adaptation Factory, you can improve your old, worn weapon!",
          "PromptTextConfidence": "KnubotAppendText 20260726-Antonio-Stacklund",
          "Options": [
            {
              "Id": "antonio_001_0",
              "Index": 0,
              "Text": "As a matter of fact I would like to upgrade my weapon...",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_upgrade_menu",
              "Actions": []
            },
            {
              "Id": "antonio_001_1",
              "Index": 1,
              "Text": "Do you have any weapons to sell?",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_sale",
              "Actions": []
            },
            {
              "Id": "antonio_001_2",
              "Index": 2,
              "Text": "Do you only have weapons and weapon upgrades?",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_other",
              "Actions": []
            },
            {
              "Id": "antonio_001_3",
              "Index": 3,
              "Text": "Goodbye",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_goodbye",
              "Actions": [
                {
                  "Type": "EndDialogue"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "antonio_sale",
          "PromptText": "Of course! Take a look.",
          "PromptTextConfidence": "KnubotAppendText 20260726-Antonio-Stacklund sale",
          "Options": [
            {
              "Id": "antonio_sale_0",
              "Index": 0,
              "Text": "Goodbye",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_goodbye",
              "Actions": [
                {
                  "Type": "EndDialogue"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "antonio_other",
          "PromptText": "Actually, you can use the adaption factory to make other things. How about a bracer? A leather vest? Or maybe a hud device is what you are looking for?",
          "PromptTextConfidence": "KnubotAppendText 20260726-Antonio-Stacklund other",
          "Options": [
            {
              "Id": "antonio_other_0",
              "Index": 0,
              "Text": "Teach me how to make a bracer.",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_craft_bracer",
              "Actions": []
            },
            {
              "Id": "antonio_other_1",
              "Index": 1,
              "Text": "Teach me how to make a leather vest.",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_craft_vest",
              "Actions": []
            },
            {
              "Id": "antonio_other_2",
              "Index": 2,
              "Text": "Teach me how to make a hud device.",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_craft_hud",
              "Actions": []
            },
            {
              "Id": "antonio_other_3",
              "Index": 3,
              "Text": "Goodbye",
              "TextEvidence": "KnuBotAnswerList 20260726-Antonio-Stacklund",
              "NextNodeId": "antonio_goodbye",
              "Actions": [
                {
                  "Type": "EndDialogue"
                }
              ]
            }
          ],
          "EnterActions": []
        },
        {
