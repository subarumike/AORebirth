        {
          "Id": "desmond_help_goodbye",
          "PromptText": "Let's get one thing straight: I don't need anyone's help for anything. But, there is a situation on my hands that needs to be dealt with. A new face like yourself will do good here.\\n\\nSome of my workers are outside protesting. Something about unfair payment or my harsh working conditions. They are all lucky to have jobs here with the ICC. I need you to rough up a couple of those Protesters that are forming outside. It's bad for business, and I don't need ICC to start breathing down my neck.",
          "PromptTextConfidence": "KnubotAppendText 20260801-Desmond Calitri seq=2357 Unknown2=0",
          "Options": [
            {
              "Id": "desmond_help_goodbye_0",
              "Index": 0,
              "Text": "Goodbye",
              "TextEvidence": "20260801-Desmond Calitri",
              "NextNodeId": "desmond_close",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "desmond_protester_return",
