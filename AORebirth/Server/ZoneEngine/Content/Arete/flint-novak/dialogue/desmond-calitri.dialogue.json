        {
          "Id": "desmond_burger_trade_hold",
          "PromptText": "Yes, I can smell it. Hand it over.",
          "PromptTextConfidence": "KnubotAppendText 20260801-Desmond Calitri seq=2016 then KnuBotStartTrade",
          "Options": [
            {
