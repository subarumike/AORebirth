          "Options": [
            {
              "Id": "desmond_protester_return_0",
              "Index": 0,
              "Text": "I took care of those protesters.",
              "TextEvidence": "20260801-Desmond Calitri",
              "NextNodeId": "desmond_decision",
              "Actions": []
            },
            {
              "Id": "desmond_protester_return_1",
              "Index": 1,
              "Text": "I have some questions...",
              "TextEvidence": "20260801-Desmond Calitri",
              "NextNodeId": "desmond_close",
              "Actions": []
            },
            {
              "Id": "desmond_protester_return_2",
              "Index": 2,
              "Text": "Goodbye",
              "TextEvidence": "20260801-Desmond Calitri",
              "NextNodeId": "desmond_close",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "desmond_decision",
          "PromptText": "Good, serves them right. They are all lucky to have a job with ICC and such a caring boss like myself. If they keep up with these protests, they'll wake up in the desert. In small pieces.\\n\\nNow there's just one last thing I need from you, and then maybe I'll let you join my workforce. The organizer of these Protests, and the person putting ideas of \"unions\" and \"fair\" working conditions...I need you to shut him up.\\n\\nFind that upstart, Cedric Harding. Make an example out of him, and I may count you as one of my own.",
          "PromptTextConfidence": "KnubotAppendText 20260801-Desmond Calitri seq=3682 Unknown2=0",
          "Options": [
            {
              "Id": "desmond_decision_0",
              "Index": 0,
              "Text": "I'll take care of it.",
              "TextEvidence": "20260801-Desmond Calitri",
              "NextNodeId": "desmond_wetwork_goodbye",
              "Actions": []
            },
            {
              "Id": "desmond_decision_1",
              "Index": 1,
              "Text": "Something about this doesn't seem right...",
