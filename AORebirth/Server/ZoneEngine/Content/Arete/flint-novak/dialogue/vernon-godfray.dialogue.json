        },
        {
          "Id": "vernon_return_003",
          "PromptText": null,
          "PromptSegments": [
            {
              "Text": "Hunching over again the man peers once more at the floating green tube, seemingly lost in its sparkling shine. As he doesn't respond to your question you assume that the answer would be 'no'; with your newly programmed chip in hand, you decide to leave him to his own devices.",
              "Unknown2": 1
