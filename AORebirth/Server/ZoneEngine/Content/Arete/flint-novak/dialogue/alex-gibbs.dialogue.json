              "NextNodeId": "alex_q_uncaptured",
              "Actions": []
            },
            {
              "Id": "alex_q_idea_option_2",
              "Index": 2,
              "Text": "What goes on here?",
              "TextEvidence": "KnuBotAnswerList 2026-07-22T13:07:44.5592769Z; not selected",
              "NextNodeId": "alex_q_uncaptured",
              "Actions": []
