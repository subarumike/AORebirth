              "NextNodeId": "stan_deliver_trade",
              "Actions": []
            },
            {
              "Id": "stan_deliver_001_option_1",
              "Index": 1,
              "Text": "I have some questions.",
              "TextEvidence": "KnuBotAnswerList 2026-07-22T19:25:03.7040592Z",
              "NextNodeId": "stan_questions_001",
              "Actions": []
            },
            {
              "Id": "stan_deliver_001_option_2",
              "Index": 2,
              "Text": "Goodbye",
              "TextEvidence": "KnuBotAnswerList 2026-07-22T19:25:03.7040592Z",
              "NextNodeId": "stan_goodbye",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "stan_deliver_trade",
          "PromptText": "Excellent, I was starting to get worried. I didn't want to deal with ICC and their incessant questioning again.\\n\\nLets go ahead and get at least part of your identification issue settled! I'll need the Nano Transmitter, the Blank Info Chip, and the Encryption Compiler and ofcourse the Adaptation Factory if you please.",
          "PromptTextConfidence": "KnubotAppendText 20260722-212421 19:25:07.417 then KnubotStartTrade",
          "Options": [
            {
              "Id": "stan_deliver_trade_option_0",
              "Index": 0,
              "Text": "(Continue after trade)",
              "TextEvidence": "Synthetic; post RejectedItems → AnswerList Thanks/can't believe/Goodbye",
              "NextNodeId": "stan_deliver_002",
              "Actions": []
            }
          ],
          "EnterActions": []
        },
        {
          "Id": "stan_deliver_002",
          "PromptText": null,
          "PromptSegments": [
            {
              "Text": "He pockets the adaptation factory before turning his attention to the three pieces of your future ID chip, plugging them all together.",
              "Unknown2": 1
            },
            {
              "Text": "It would seem my instincts were correct about you. You're a natural. All it needs now is some additional information and security clearance codes and you should be ready to go. Visit Sarah Greene an 'associate' of mine, and if you're smart you'd do well to leave out my name. \\nAlso if you haven't done so already you should see my good friend Marco Spida and buy a Nanoprogram Container.",
              "Unknown2": 0
            }
          ],
          "PromptTextConfidence": "KnubotAppendText 20260722-212421 19:25:19.097 Unknown2=1 then 0",
          "Options": [
            {
              "Id": "stan_deliver_002_option_0",
              "Index": 0,
              "Text": "Thanks, it was fun.",
              "TextEvidence": "KnuBotAnswerList 2026-07-22T19:25:19.0985640Z",
