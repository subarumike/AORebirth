  </ItemGroup>
  <ItemGroup Condition="'$(LoginCharacterCreationFocusedTests)' != 'true'">
    <Compile Remove="CharacterCreationTests.cs" />
    <Compile Remove="CharacterListTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MissionChestFocusedTests)' == 'true'">
    <Compile Remove="@(Compile)" />
    <Compile Include="TestDoubles.cs" />
    <Compile Include="InventoryActionTests.cs" />
    <Compile Include="MissionChestLootTests.cs" />
    <Compile Include="MissionChestRKPolicyTests.cs" />
    <Compile Include="ChestCommandTests.cs" />
    <Compile Include="MissionChestPlacementTests.cs" />
