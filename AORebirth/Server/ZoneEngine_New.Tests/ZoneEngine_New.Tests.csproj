    <Compile Include="MissionTrapRuntimeTests.cs" />
    <Compile Include="MissionTrapResourceTests.cs" />
    <Compile Include="MissionTrapPersistenceTests.cs" />
    <Compile Include="../../../tools-temp/AOSharpCaptureProtocol/RawTrapFullUpdateDecoder.cs" Link="Fixtures/RawTrapFullUpdateDecoder.cs" />
    <Compile Include="AuthoredMissionTestDao.cs" />
    <Compile Include="PlayerInventoryOverflowTests.cs" />
    <Compile Include="ReconnectVisibilityTests.cs" />
    <Compile Include="ExactSpawnVisibilityTests.cs" />
    <Compile Include="FindItemRewardTests.cs" />
    <Compile Include="QuestDungeonDestinationTests.cs" />
    <Compile Include="ProceduralDungeonFoundationTests.cs" />
    <Compile Include="MissionDestinationIntegrationTests.cs" />
    <Compile Include="../../Libraries/Source/AOtomation/AOtomation.Messaging/src/SmokeLounge.AOtomation.Messaging.Tests/MissionLevelGraphTests.cs" Link="Missions/MissionLevelGraphTests.cs" />
  </ItemGroup>
