    <Compile Include="../../Libraries/Source/AOtomation/AOtomation.Messaging/src/SmokeLounge.AOtomation.Messaging.Tests/MissionRollTemplateContractTests.cs" Link="Missions/MissionRollTemplateContractTests.cs" />
    <!-- Historical combat fixtures compile only into tests, never NewEngine. -->
    <Compile Include="../../../Tests/Fixtures/Gameplay/Combat/*.cs" Link="Fixtures/Combat/%(Filename)%(Extension)" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedEnemyCombatProfileCatalog.g.cs" Link="Fixtures/CapturedEnemyCombatProfileCatalog.g.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Packets/MorphCaptureWireCatalog.cs" Link="Fixtures/MorphCaptureWireCatalog.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Doja/DojaChipInteractionRules.cs" Link="Fixtures/DojaChipInteractionRules.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Doja/DojaChipPacketSender.Data.cs" Link="Fixtures/DojaChipPacketSender.Data.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedSubwayVendorContentProvider.cs" Link="Fixtures/CapturedSubwayVendorContentProvider.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedBucketheadTechnodealerContentProvider.cs" Link="Fixtures/CapturedBucketheadTechnodealerContentProvider.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedThrakGardenVendorContentProvider.cs" Link="Fixtures/CapturedThrakGardenVendorContentProvider.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedAbanGardenVendorContentProvider.cs" Link="Fixtures/CapturedAbanGardenVendorContentProvider.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedAreteMarcoSpidaVendorContentProvider.cs" Link="Fixtures/CapturedAreteMarcoSpidaVendorContentProvider.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedAreteAlexAreaVendorStockDefinition.cs" Link="Fixtures/CapturedAreteAlexAreaVendorStockDefinition.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedAreteAlexAreaVendorDefinition.cs" Link="Fixtures/CapturedAreteAlexAreaVendorDefinition.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedAreteAlexAreaVendorContentProvider.cs" Link="Fixtures/CapturedAreteAlexAreaVendorContentProvider.cs" />
    <Compile Include="../../../Tests/Fixtures/Gameplay/Playfields/CapturedAreteLoreleiVendorContentProvider.cs" Link="Fixtures/CapturedAreteLoreleiVendorContentProvider.cs" />
    <EmbeddedResource Include="Fixtures/LegacyProductionCharacterStats.json" />
  </ItemGroup>
  <!-- Explicit focused run: the clean baseline contains unrelated stale test types.
       The default/full suite remains unchanged and continues reporting those failures. -->
  <ItemGroup Condition="'$(MissionDestinationFocusedTests)' == 'true'">
    <Compile Remove="@(Compile)" />
    <Compile Include="TestDoubles.cs" />
    <Compile Include="MissionDestinationIntegrationTests.cs" />
    <Compile Include="QuestDungeonDestinationTests.cs" />
    <Compile Include="FindItemRewardTests.cs" />
    <Compile Include="ProceduralDungeonFoundationTests.cs" />
