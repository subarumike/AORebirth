<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ZoneEngine_New.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GroveGames.BehaviourTree" Version="1.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.10.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.10.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoneEngine_New\ZoneEngine_New.csproj" />
    <ProjectReference Include="../../Libraries/Source/AORebirth.World.Collision/AORebirth.World.Collision.csproj" />
    <ProjectReference Include="../../../Tools/DatabaseMigrationTool/DatabaseMigrationTool.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../ChatEngine/CoreServer/ChatSessionOwnership.cs" Link="ChatSessionOwnership.cs" />
    <Compile Include="../../../tools-temp/AOSharpCaptureProtocol/RawTrapFullUpdateDecoder.cs" Link="Fixtures/RawTrapFullUpdateDecoder.cs" />
    <!-- Existing mission behavior tests now exercise the native implementation directly. -->
    <Compile Include="../../Libraries/Source/AOtomation/AOtomation.Messaging/src/SmokeLounge.AOtomation.Messaging.Tests/MissionLevelGraphTests.cs" Link="Missions/MissionLevelGraphTests.cs" />
