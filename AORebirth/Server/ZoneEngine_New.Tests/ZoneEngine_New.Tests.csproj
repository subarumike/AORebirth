    <Compile Remove="@(Compile)" />
    <Compile Include="TestDoubles.cs" />
    <Compile Include="ExpansionEntitlementHydrationTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(LoginCharacterCreationFocusedTests)' == 'true'">
    <!-- Login uses the existing full engine libraries; the normal Zone suite keeps its trimmed references. -->
    <ProjectReference Remove="@(ProjectReference)" />
    <ProjectReference Include="../../../WindowsBuildNet10/Projects/LoginEngine.WinNet10.csproj" />
    <Compile Remove="@(Compile)" />
    <Compile Include="CharacterCreationTests.cs" />
    <Compile Include="CharacterListTests.cs" />
