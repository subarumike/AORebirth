  </ItemGroup>
  <ItemGroup Condition="'$(ModuleApiFocusedTests)' == 'true'">
    <Compile Remove="@(Compile)" />
    <Compile Include="TestDoubles.cs" />
    <Compile Include="ModuleApiTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameDataReloadFocusedTests)' == 'true'">
    <Compile Remove="@(Compile)" />
    <Compile Include="TestDoubles.cs" />
    <Compile Include="GameDataReloadTests.cs" />
