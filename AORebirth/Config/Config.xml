<?xml version="1.0" encoding="utf-8"?>
<Config>
  <!-- Ports for the Game Engines -->
  <ListenIP>0.0.0.0</ListenIP>
  <ChatIP>127.0.0.1</ChatIP>
  <ZoneIP>127.0.0.1</ZoneIP>
  <ChatPort>7012</ChatPort>
  <ZonePort>7501</ZonePort>
  <LoginPort>7500</LoginPort>
  <CommPort>6996</CommPort>
  <!-- Playfield simulation ticks per second (default 32) -->
  <PlayfieldTickRate>32</PlayfieldTickRate>
  <!-- Seconds a disconnected player stays visible (LinkDead) before despawn (default 60) -->
  <LinkDeadTimeoutSeconds>60</LinkDeadTimeoutSeconds>
  <Locality>
    <!-- Safety default: locality visibility remains active while character ticks stay full-rate. -->
    <EnableCellHeatScheduling>false</EnableCellHeatScheduling>
    <VisibilityNeighborLevel>2</VisibilityNeighborLevel>
    <HotNeighborLevel>1</HotNeighborLevel>
    <WarmNeighborLevel>2</WarmNeighborLevel>
    <CellSleepTime>30</CellSleepTime>
    <!-- Max hash-spawns per awake cell tick (default 1). -->
    <SpawnRate>1</SpawnRate>
  </Locality>
  <!-- Debug console categories: comma-separated DebugInfoDetail names (default Engine,Error) -->
  <!-- Locality: player cell changes + cell heat (Hot/Warm/Cold/Asleep) + hash-spawns in ZoneEngine_NewLog -->
  <!-- Network: ZoneEngine_New inbound/outbound message type names -->
  <!-- <DebugInfoDetail>Engine,Error,Locality,Network</DebugInfoDetail> -->
  <!-- Log Area -->
  <SqlLog>true</SqlLog>
  <LogChat>false</LogChat>
  <!-- Server MOTD -->
  <!-- {0} will be replaced with Cellao Name and Version eg Yalm 1.3.2.267 -->
  <Motd>https://ao-rebirth.com</Motd>
  <!-- Choose your SQL Databse Type here, MySql, MsSql, PostgreSQL-->
  <SQLType>MySql</SQLType>
  <!-- Sql Connection Setup Area -->
  <MysqlConnection>Server=localhost;Database=cellao_codex_clean;Uid=cellaodbuser;Pwd=REPLACE_WITH_LOCAL_PASSWORD</MysqlConnection>
  <MsSqlConnection>Data Source=localhost;Initial Catalog=cellao;UserID=cellaodbuser;Password=REPLACE_WITH_LOCAL_PASSWORD;Trusted_Connection=false</MsSqlConnection>
  <PostgreConnection>Server=localhost;User Id=cellaodbuser;Password=REPLACE_WITH_LOCAL_PASSWORD;Database=cellao</PostgreConnection>
  <!-- This area is for Locale Settings, en = english, gr = german, ro = Romanian more languages will be supported later, Default = en-->
  <Locale>en</Locale>
  <!-- WebEngine Setup -->
  <WebHostName>test.aocell.info</WebHostName>
  <WebHostPort>8181</WebHostPort>
  <WebHostRoot>htdocs</WebHostRoot>
  <WebHostDefaultPage>index.php</WebHostDefaultPage>
  <WebHostPhpPath>php</WebHostPhpPath>
</Config>
