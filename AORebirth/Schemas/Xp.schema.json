{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Xp.schema.json",
  "title": "XP table: the level rows, keyed by level, and the NPC families whose kills give no XP.",
  "description": "Generated by Tools/GameDataSchemas from GameDataStore.XpLevelRow and NoKillXpFamilyCatalog.FamilyRow; do not edit by hand.",
  "type": "object",
  "properties": {
    "NoKillXpFamilies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Family": {
            "type": "integer",
            "minimum": 0,
            "description": "NPCFamily (stat 455)."
          },
          "Note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "Family"
        ]
      }
    }
  },
  "patternProperties": {
    "^[1-9][0-9]*$": {
      "type": "object",
      "properties": {
        "KillAward": {
          "type": "integer"
        },
        "NextLevelXp": {
          "type": "integer"
        },
        "XPKillRange": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
