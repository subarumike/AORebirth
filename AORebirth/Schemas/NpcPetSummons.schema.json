{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "NpcPetSummons.schema.json",
  "title": "NPC combat pet creation items and their authored policy.",
  "description": "Generated by Tools/GameDataSchemas from NpcPetSummonProfile; do not edit by hand.",
  "type": "object",
  "properties": {
    "Version": {
      "type": "integer",
      "const": 1
    },
    "CreationItemTemplateIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "Policy": {
      "type": "object",
      "properties": {
        "MaxPets": {
          "type": "integer",
          "minimum": 0
        },
        "SummonIntervalSeconds": {
          "type": "number",
          "minimum": 0
        },
        "RespawnDelaySeconds": {
          "type": "number",
          "minimum": 0
        },
        "RetryDelaySeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "MaxPets",
        "SummonIntervalSeconds",
        "RespawnDelaySeconds",
        "RetryDelaySeconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "Version",
    "CreationItemTemplateIds",
    "Policy"
  ],
  "additionalProperties": false
}
