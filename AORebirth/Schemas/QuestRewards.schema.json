          "null"
        ]
      },
      "PickOne": {
        "type": "boolean"
      },
      "Entries": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "object",
          "properties": {
            "If": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "properties": {
                  "Stat": {
                    "type": "string"
                  },
                  "Operator": {
                    "type": "string"
                  },
                  "Value": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            },
            "Items": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "properties": {
                  "Hash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "Id": {
                    "type": "integer"
                  },
                  "HighId": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "Name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "Ql": {
                    "description": "QL to give: a positive number, or \u0022level\u0022 for the player\u0027s level. Default 1.",
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "const": "level"
                      }
                    ]
                  },
                  "Count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
