{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SpecialAttackMultipliers.schema.json",
  "title": "ZoneEngine stealth special multipliers",
  "description": "An array position i represents multiplier i + 1. Skills must be distinct. The engine interpolates relative weights between skill rows, uses 1x below the first band, and uses the last band's weights above it.",
  "type": "object",
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill", "weights"],
        "properties": {
          "skill": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "weights": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "contains": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  }
}
