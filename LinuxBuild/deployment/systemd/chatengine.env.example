# Copy to /etc/ao-rebirth/chatengine/chatengine.env, keep it root-readable only,
# and add AO_REBIRTH_MYSQL_CONNECTION there. Never commit the real value.
AO_REBIRTH_CONFIG_PATH=/etc/ao-rebirth/chatengine/Config.xml
AO_REBIRTH_CHAT_LISTEN_IP=127.0.0.1
AO_REBIRTH_ISCOM_LISTEN_IP=127.0.0.1
AO_REBIRTH_REQUIRED_SQL_TYPE=MySql

# Required, but deliberately omitted from source control:
# AO_REBIRTH_MYSQL_CONNECTION=<set only in the root-readable VPS copy>
