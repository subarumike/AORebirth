# Review and apply the bot schema before enabling this service. Keep the live
# file root-readable only. Never commit connection strings or private keys.
AO_REBIRTH_BOT_SERVICE_ENABLED=false
AO_REBIRTH_BOT_CHAT_HOST=127.0.0.1
AO_REBIRTH_BOT_CHAT_PORT=7411
AO_REBIRTH_BOT_DB_PROVIDER=MySqlConnector.MySqlConnection, MySqlConnector
AO_REBIRTH_BOT_POLL_MS=250
AO_REBIRTH_BOT_RECONNECT_INITIAL_MS=500
AO_REBIRTH_BOT_RECONNECT_MAX_MS=30000

# Required only after schema approval and before setting ENABLED=true:
# AO_REBIRTH_MYSQL_CONNECTION=<root-readable private identity database connection>
# AO_REBIRTH_BOT_CHAT_KEY=<base64 key matching the loopback ChatEngine key>
