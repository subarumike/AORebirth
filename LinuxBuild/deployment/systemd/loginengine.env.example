# Copy to /etc/ao-rebirth/loginengine/loginengine.env, keep it root-readable
# only, and add AO_REBIRTH_MYSQL_CONNECTION there. Never commit the real value.
AO_REBIRTH_CONFIG_PATH=/etc/ao-rebirth/loginengine/Config.xml
AO_REBIRTH_LOGIN_LISTEN_IP=127.0.0.1
AO_REBIRTH_REQUIRED_SQL_TYPE=MySql
AO_REBIRTH_EXPECTED_DATABASE=aorebirth_chatengine_stage6

# Required, but deliberately omitted from source control:
# AO_REBIRTH_MYSQL_CONNECTION=<set only in the root-readable VPS copy>
