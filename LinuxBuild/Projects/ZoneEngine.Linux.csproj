<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ZoneEngine</AssemblyName>
    <RootNamespace>ZoneEngine</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <DefineConstants>TRACE;AOREBIRTH_LINUX</DefineConstants>
    <Deterministic>true</Deterministic>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AORebirthRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</AORebirthRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MemBus" Version="4.0.1" />
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="System.CodeDom" Version="10.0.10" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="AORebirth.Communication.Linux.csproj" />
    <ProjectReference Include="AORebirth.Core.Linux.csproj" />
    <ProjectReference Include="AORebirth.Database.Linux.csproj" />
    <ProjectReference Include="AORebirth.Enums.Linux.csproj" />
    <ProjectReference Include="AORebirth.Exceptions.Linux.csproj" />
    <ProjectReference Include="AORebirth.Interfaces.Linux.csproj" />
    <ProjectReference Include="AORebirth.ObjectManager.Linux.csproj" />
    <ProjectReference Include="AORebirth.Stats.Linux.csproj" />
    <ProjectReference Include="Cell.Core.Linux.csproj" />
    <ProjectReference Include="Ionic.Zlib.Linux.csproj" />
    <ProjectReference Include="MsgPack.Mono.Linux.csproj" />
    <ProjectReference Include="PlayfieldLoader.Linux.csproj" />
    <ProjectReference Include="SmokeLounge.AOtomation.Messaging.Linux.csproj" />
    <ProjectReference Include="Translations.Linux.csproj" />
    <ProjectReference Include="Utility.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Compatibility/ZoneEngine/JavaScriptSerializer.Linux.cs">
      <Link>Compatibility/JavaScriptSerializer.Linux.cs</Link>
    </Compile>
  </ItemGroup>

  <Import Project="../source-inventory/ZoneEngine.CompileItems.props" />
  <Import Project="../source-inventory/ZoneEngine.ContentItems.props" />
  <Import Project="../source-inventory/ZoneEngine.RuntimeCopyItems.props" />
</Project>
