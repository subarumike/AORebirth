<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ChatEngine</AssemblyName>
    <RootNamespace>ChatEngine</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <DefineConstants>TRACE;AOREBIRTH_LINUX</DefineConstants>
    <Deterministic>true</Deterministic>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AORebirthRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</AORebirthRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="AORebirth.Chat.Authentication.Linux.csproj" />
    <ProjectReference Include="AORebirth.Communication.Linux.csproj" />
    <ProjectReference Include="AORebirth.Database.Linux.csproj" />
    <ProjectReference Include="AORebirth.Enums.Linux.csproj" />
    <ProjectReference Include="AORebirth.Stats.Linux.csproj" />
    <ProjectReference Include="Cell.Core.Linux.csproj" />
    <ProjectReference Include="SmokeLounge.AOtomation.Messaging.Linux.csproj" />
    <ProjectReference Include="Translations.Linux.csproj" />
    <ProjectReference Include="Utility.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(AORebirthRepositoryRoot)/AORebirth/Config/Config.xml">
      <Link>Config.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Import Project="../source-inventory/ChatEngine.CompileItems.props" />
</Project>
