<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Ionic.Zlib</AssemblyName>
    <RootNamespace>Ionic.Zlib</RootNamespace>
    <Version>1.9.1.5</Version>
    <AssemblyVersion>1.9.1.5</AssemblyVersion>
    <FileVersion>1.9.1.5</FileVersion>
    <InformationalVersion>1.9.1.5-linux-compat</InformationalVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Compatibility/Utility/IonicZlibCompatibility.cs" Link="IonicZlibCompatibility.cs" />
  </ItemGroup>
</Project>
