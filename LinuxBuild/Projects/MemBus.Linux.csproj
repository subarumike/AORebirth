<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>MemBus</AssemblyName>
    <RootNamespace>MemBus</RootNamespace>
    <Version>2.0.2</Version>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <FileVersion>2.0.2.0</FileVersion>
    <InformationalVersion>2.0.2-linux-compat</InformationalVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Compatibility/Communication/MemBusCompatibility.cs" Link="MemBusCompatibility.cs" />
  </ItemGroup>
</Project>
