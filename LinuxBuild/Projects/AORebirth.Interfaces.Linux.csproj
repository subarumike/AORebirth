<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AORebirth.Interfaces</AssemblyName>
    <RootNamespace>AORebirth.Interfaces</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <DefineConstants>TRACE;AOREBIRTH_LINUX</DefineConstants>
    <Deterministic>true</Deterministic>
    <AORebirthRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</AORebirthRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="SmokeLounge.AOtomation.Messaging.Linux.csproj" />
    <ProjectReference Include="MsgPack.Mono.Linux.csproj" />
    <ProjectReference Include="Utility.Linux.csproj" />
  </ItemGroup>

  <Import Project="../source-inventory/AORebirth.Interfaces.CompileItems.props" />
</Project>
