  <ItemGroup>
    <Compile Include="../Stage2ContractFingerprint.cs" Link="Stage2ContractFingerprint.cs" />
    <Compile Include="../Stage7ContractFingerprint.cs" Link="Stage7ContractFingerprint.cs" />
