  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Projects/AORebirth.Core.Login.Linux.csproj" />
    <ProjectReference Include="../../Projects/LoginEngine.Linux.csproj" />
  </ItemGroup>
</Project>
